<Application
  x:Class="DispHub.App"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ctl="clr-namespace:DispHub.Controls"
  xmlns:l="clr-namespace:DispHub.Localization"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:views="clr-namespace:DispHub.Views"
  xmlns:vm="clr-namespace:DispHub.ViewModels"
  ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ui:ThemesDictionary Theme="Dark" />
        <ui:ControlsDictionary />
        <ResourceDictionary Source="Resources/Styles.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <!-- Subclasses don't pick up implicit styles of their base type. -->
      <Style BasedOn="{StaticResource {x:Type ScrollViewer}}" TargetType="ctl:SmoothScrollViewer" />
      <Style BasedOn="{StaticResource {x:Type Button}}" TargetType="ctl:HotkeyBox" />

      <!-- WPF UI leaves the window's own buttons without a name for screen readers. -->
      <Style BasedOn="{StaticResource {x:Type ui:TitleBarButton}}" TargetType="ui:TitleBarButton">
        <Style.Triggers>
          <Trigger Property="ButtonType" Value="Minimize">
            <Setter Property="AutomationProperties.Name" Value="{l:Tr Window_Minimise}" />
          </Trigger>
          <Trigger Property="ButtonType" Value="Maximize">
            <Setter Property="AutomationProperties.Name" Value="{l:Tr Window_Maximise}" />
          </Trigger>
          <Trigger Property="ButtonType" Value="Restore">
            <Setter Property="AutomationProperties.Name" Value="{l:Tr Window_Restore}" />
          </Trigger>
          <Trigger Property="ButtonType" Value="Close">
            <Setter Property="AutomationProperties.Name" Value="{l:Tr Window_Close}" />
          </Trigger>
        </Style.Triggers>
      </Style>

      <DataTemplate DataType="{x:Type vm:HomeViewModel}">
        <views:HomeView />
      </DataTemplate>
      <DataTemplate DataType="{x:Type vm:ProfilesViewModel}">
        <views:ProfilesView />
      </DataTemplate>
      <DataTemplate DataType="{x:Type vm:ScheduleViewModel}">
        <views:ScheduleView />
      </DataTemplate>
      <DataTemplate DataType="{x:Type vm:AppsViewModel}">
        <views:AppsView />
      </DataTemplate>
      <DataTemplate DataType="{x:Type vm:DisplaysViewModel}">
        <views:DisplaysView />
      </DataTemplate>
      <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
        <views:SettingsView />
      </DataTemplate>
      <DataTemplate DataType="{x:Type vm:AboutViewModel}">
        <views:AboutView />
      </DataTemplate>
    </ResourceDictionary>
  </Application.Resources>
</Application>
