<ui:FluentWindow
  x:Class="DispHub.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ctl="clr-namespace:DispHub.Controls"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:l="clr-namespace:DispHub.Localization"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:vm="clr-namespace:DispHub.ViewModels"
  Title="DispHub"
  Width="1100"
  Height="760"
  MinWidth="760"
  MinHeight="520"
  d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
  ExtendsContentIntoTitleBar="True"
  Icon="pack://application:,,,/Assets/DispHub.ico"
  WindowBackdropType="Mica"
  WindowCornerPreference="Round"
  WindowStartupLocation="CenterScreen"
  mc:Ignorable="d">
  <Window.Resources>
    <DataTemplate x:Key="NavEntry" DataType="{x:Type vm:PageViewModel}">
      <StackPanel Orientation="Horizontal" ToolTip="{Binding Title}">
        <StackPanel.Style>
          <Style TargetType="StackPanel">
            <Style.Triggers>
              <!-- Icons only: centre them, so the compact bar is symmetrical. -->
              <DataTrigger Binding="{Binding DataContext.IsNavExpanded, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                <Setter Property="HorizontalAlignment" Value="Center" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </StackPanel.Style>
        <ui:SymbolIcon FontSize="18" Symbol="{Binding Icon}" />
        <TextBlock
          Margin="12,0,0,0"
          VerticalAlignment="Center"
          Text="{Binding Title}"
          Visibility="{Binding DataContext.IsNavExpanded, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}" />
      </StackPanel>
    </DataTemplate>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <ui:TitleBar Title="DispHub" Grid.Row="0">
      <ui:TitleBar.Icon>
        <ui:ImageIcon RenderOptions.BitmapScalingMode="HighQuality" Source="pack://application:,,,/Assets/DispHub-64.png" />
      </ui:TitleBar.Icon>
    </ui:TitleBar>

    <Grid Grid.Row="1">
      <Grid.LayoutTransform>
        <ScaleTransform ScaleX="{Binding TextScale}" ScaleY="{Binding TextScale}" />
      </Grid.LayoutTransform>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="{Binding NavWidth}" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <DockPanel Margin="8,4,8,10">
        <ListBox
          Background="Transparent"
          BorderThickness="0"
          DockPanel.Dock="Bottom"
          ItemContainerStyle="{StaticResource NavItem}"
          ItemTemplate="{StaticResource NavEntry}"
          ItemsSource="{Binding FooterPages}"
          SelectedItem="{Binding SelectedFooterPage}" />

        <Border
          Margin="0,8,0,8"
          Padding="12"
          Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
          BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
          BorderThickness="1"
          CornerRadius="8"
          DockPanel.Dock="Bottom"
          Visibility="{Binding ShowUpgradeCard, Converter={StaticResource BoolToVisibility}}">
          <StackPanel>
            <TextBlock FontWeight="SemiBold" Text="DispHub Pro" />
            <TextBlock
              Margin="0,4,0,10"
              Style="{StaticResource Hint}"
              Text="{l:Tr Pro_ShortPitch}" />
            <ui:Button
              HorizontalAlignment="Stretch"
              Appearance="Primary"
              Command="{Binding UpgradeCommand}"
              Content="{l:Tr Common_GetPro}" />
          </StackPanel>
        </Border>

        <ListBox
          Background="Transparent"
          BorderThickness="0"
          ItemContainerStyle="{StaticResource NavItem}"
          ItemTemplate="{StaticResource NavEntry}"
          ItemsSource="{Binding Pages}"
          SelectedItem="{Binding SelectedTopPage}" />
      </DockPanel>

      <Border
        Grid.Column="1"
        Background="{DynamicResource LayerFillColorDefaultBrush}"
        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
        BorderThickness="1,1,0,0"
        CornerRadius="8,0,0,0">
        <ctl:SmoothScrollViewer x:Name="PageScroller">
          <ContentControl
            MaxWidth="960"
            Margin="36,28,36,36"
            Content="{Binding SelectedPage}"
            Focusable="False" />
        </ctl:SmoothScrollViewer>
      </Border>
    </Grid>
  </Grid>
</ui:FluentWindow>
