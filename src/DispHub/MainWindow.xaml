<ui:FluentWindow
  x:Class="DispHub.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ctl="clr-namespace:DispHub.Controls"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:vm="clr-namespace:DispHub.ViewModels"
  Title="DispHub"
  Width="1060"
  Height="740"
  MinWidth="780"
  MinHeight="520"
  d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
  ExtendsContentIntoTitleBar="True"
  Icon="pack://application:,,,/Assets/DispHub.ico"
  WindowBackdropType="Mica"
  WindowCornerPreference="Round"
  WindowStartupLocation="CenterScreen"
  mc:Ignorable="d">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <ui:TitleBar Title="DispHub" Grid.Row="0">
      <ui:TitleBar.Icon>
        <ui:ImageIcon Source="pack://application:,,,/Assets/DispHub.png" />
      </ui:TitleBar.Icon>
    </ui:TitleBar>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="210" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <DockPanel Margin="8,4,8,12">
        <Border
          Margin="0,8,0,0"
          Padding="12"
          Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
          BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
          BorderThickness="1"
          CornerRadius="8"
          DockPanel.Dock="Bottom"
          Visibility="{Binding ShowUpgrade, Converter={StaticResource BoolToVisibility}}">
          <StackPanel>
            <TextBlock FontWeight="SemiBold" Text="DispHub Pro" />
            <TextBlock
              Margin="0,4,0,10"
              Style="{StaticResource Hint}"
              Text="Per-app profiles, schedules and per-display settings. One-time purchase." />
            <ui:Button
              HorizontalAlignment="Stretch"
              Appearance="Primary"
              Command="{Binding UpgradeCommand}"
              Content="Get Pro" />
          </StackPanel>
        </Border>

        <ListBox
          Background="Transparent"
          BorderThickness="0"
          ItemContainerStyle="{StaticResource NavItem}"
          ItemsSource="{Binding Pages}"
          SelectedItem="{Binding SelectedPage}">
          <ListBox.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:PageViewModel}">
              <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon
                  Margin="0,0,12,0"
                  FontSize="18"
                  Symbol="{Binding Icon}" />
                <TextBlock VerticalAlignment="Center" Text="{Binding Title}" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>

      <Border
        Grid.Column="1"
        Background="{DynamicResource LayerFillColorDefaultBrush}"
        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
        BorderThickness="1,1,0,0"
        CornerRadius="8,0,0,0">
        <ctl:SmoothScrollViewer x:Name="PageScroller">
          <ContentControl
            MaxWidth="920"
            Margin="36,28,36,36"
            Content="{Binding SelectedPage}"
            Focusable="False" />
        </ctl:SmoothScrollViewer>
      </Border>
    </Grid>
  </Grid>
</ui:FluentWindow>
