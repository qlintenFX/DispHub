<UserControl
  x:Class="DispHub.Views.SettingsView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ctl="clr-namespace:DispHub.Controls"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:l="clr-namespace:DispHub.Localization"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:vm="clr-namespace:DispHub.ViewModels"
  d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
  mc:Ignorable="d">
  <UserControl.Resources>
    <DataTemplate x:Key="EnumItem">
      <TextBlock Text="{Binding Converter={x:Static ctl:EnumWordsConverter.Instance}}" />
    </DataTemplate>
    <Style x:Key="Swatch" TargetType="ListBoxItem">
      <Setter Property="Margin" Value="0,0,8,8" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="ToolTip" Value="{Binding Name}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Grid>
              <Ellipse
                x:Name="Ring"
                Width="34"
                Height="34"
                Stroke="Transparent"
                StrokeThickness="2" />
              <Ellipse
                Width="26"
                Height="26"
                Fill="{Binding Swatch}" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource ControlStrokeColorSecondaryBrush}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource TextFillColorPrimaryBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <StackPanel>
    <TextBlock Style="{StaticResource PageTitle}" Text="{l:Tr Settings_Title}" />
    <TextBlock Style="{StaticResource PageSubtitle}" Text="{l:Tr Settings_Subtitle}" />

    <!-- General -->
    <TextBlock Style="{StaticResource SectionHeader}" Text="{l:Tr Settings_General}" />
    <Border Style="{StaticResource SettingCard}">
      <Grid>
        <StackPanel Margin="0,0,80,0">
          <TextBlock Text="{l:Tr Settings_StartWithWindows}" />
          <TextBlock Style="{StaticResource Hint}" Text="{l:Tr Settings_StartWithWindowsHint}" />
          <TextBlock
            Style="{StaticResource ErrorText}"
            Text="{Binding LaunchAtLoginNote}"
            Visibility="{Binding LaunchAtLoginNote, Converter={x:Static ctl:NullToCollapsedConverter.Instance}}" />
        </StackPanel>
        <ui:ToggleSwitch HorizontalAlignment="Right" IsChecked="{Binding LaunchAtLogin}" />
      </Grid>
    </Border>
    <Border Style="{StaticResource SettingCard}">
      <Grid>
        <StackPanel Margin="0,0,80,0">
          <TextBlock Text="{l:Tr Settings_KeepRunning}" />
          <TextBlock Style="{StaticResource Hint}" Text="{l:Tr Settings_KeepRunningHint}" />
        </StackPanel>
        <ui:ToggleSwitch HorizontalAlignment="Right" IsChecked="{Binding CloseToTray}" />
      </Grid>
    </Border>
    <Border Style="{StaticResource SettingCard}">
      <Grid>
        <StackPanel Margin="0,0,240,0">
          <TextBlock Text="{l:Tr Settings_TrayClick}" />
          <TextBlock Style="{StaticResource Hint}" Text="{l:Tr Settings_TrayClickHint}" />
        </StackPanel>
        <ComboBox
          MinWidth="220"
          HorizontalAlignment="Right"
          ItemTemplate="{StaticResource EnumItem}"
          ItemsSource="{Binding TrayActions}"
          SelectedItem="{Binding TrayLeftClick}" />
      </Grid>
    </Border>
    <Border Style="{StaticResource SettingCard}">
      <Grid>
        <StackPanel Margin="0,0,240,0">
          <TextBlock Text="{l:Tr Settings_Language}" />
          <TextBlock Style="{StaticResource Hint}" Text="{l:Tr Settings_LanguageHint}" />
          <StackPanel
            Margin="0,6,0,0"
            Orientation="Horizontal"
            Visibility="{Binding LanguageNeedsRestart, Converter={StaticResource BoolToVisibility}}">
            <TextBlock
              Margin="0,0,10,0"
              VerticalAlignment="Center"
              Style="{StaticResource Hint}"
              Text="{l:Tr Settings_LanguageRestart}" />
            <ui:Button
              Appearance="Primary"
              Command="{Binding RestartCommand}"
              Content="{l:Tr Settings_RestartNow}" />
          </StackPanel>
        </StackPanel>
        <ComboBox
          MinWidth="220"
          HorizontalAlignment="Right"
          VerticalAlignment="Top"
          ItemsSource="{Binding LanguageChoices}"
          SelectedItem="{Binding Language}" />
      </Grid>
    </Border>

    <!-- Appearance -->
    <Grid>
      <TextBlock Style="{StaticResource SectionHeader}" Text="{l:Tr Settings_Appearance}" />
      <ui:HyperlinkButton
        Margin="0,16,0,0"
        Padding="6,2"
        HorizontalAlignment="Right"
        VerticalAlignment="Bottom"
        Command="{Binding ResetAppearanceCommand}"
        Content="{l:Tr Settings_ResetAppearance}" />
    </Grid>
    <Border Style="{StaticResource SettingCard}">
      <Grid>
        <StackPanel Margin="0,0,240,0">
          <TextBlock Text="{l:Tr Settings_Theme}" />
          <TextBlock Style="{StaticResource Hint}" Text="{l:Tr Settings_ThemeHint}" />
        </StackPanel>
        <ComboBox
          MinWidth="220"
          HorizontalAlignment="Right"
          ItemTemplate="{StaticResource EnumItem}"
          ItemsSource="{Binding Themes}"
          SelectedItem="{Binding Theme}" />
      </Grid>
    </Border>
    <Border Style="{StaticResource SettingCard}">
      <StackPanel>
        <TextBlock Text="{l:Tr Settings_Accent}" />
        <TextBlock Style="{StaticResource Hint}" Text="{l:Tr Settings_AccentHint}" />
        <ListBox
          Margin="0,10,0,-8"
          Background="Transparent"
          BorderThickness="0"
          ItemContainerStyle="{StaticResource Swatch}"
          ItemsSource="{Binding Accents}"
          SelectedItem="{Binding Accent}">
          <ListBox.Template>
            <ControlTemplate TargetType="ListBox">
              <ItemsPresenter />
            </ControlTemplate>
          </ListBox.Template>
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
        </ListBox>
      </StackPanel>
    </Border>
    <Border Style="{StaticResource SettingCard}">
      <Grid>
        <StackPanel Margin="0,0,240,0">
          <TextBlock Text="{l:Tr Settings_Backdrop}" />
          <TextBlock Style="{StaticResource Hint}" Text="{l:Tr Settings_BackdropHint}" />
        </StackPanel>
        <ComboBox
          MinWidth="220"
          HorizontalAlignment="Right"
          ItemTemplate="{StaticResource EnumItem}"
          ItemsSource="{Binding Backdrops}"
          SelectedItem="{Binding Backdrop}" />
      </Grid>
    </Border>
    <Border Style="{StaticResource SettingCard}">
      <Grid>
        <StackPanel Margin="0,0,240,0">
          <TextBlock Text="{l:Tr Settings_TextSize}" />
          <TextBlock Style="{StaticResource Hint}" Text="{l:Tr Settings_TextSizeHint}" />
        </StackPanel>
        <ComboBox
          MinWidth="220"
          HorizontalAlignment="Right"
          ItemsSource="{Binding TextScales}"
          SelectedItem="{Binding TextScale}" />
      </Grid>
    </Border>
    <Border Style="{StaticResource SettingCard}">
      <Grid>
        <StackPanel Margin="0,0,80,0">
          <TextBlock Text="{l:Tr Settings_CompactNav}" />
          <TextBlock Style="{StaticResource Hint}" Text="{l:Tr Settings_CompactNavHint}" />
        </StackPanel>
        <ui:ToggleSwitch HorizontalAlignment="Right" IsChecked="{Binding CompactNavigation}" />
      </Grid>
    </Border>
    <Border Style="{StaticResource SettingCard}">
      <Grid>
        <StackPanel Margin="0,0,260,0">
          <TextBlock Text="{l:Tr Settings_PreviewPicture}" />
          <TextBlock Style="{StaticResource Hint}" Text="{l:Tr Settings_PreviewPictureHint}" />
        </StackPanel>
        <ComboBox
          MinWidth="240"
          HorizontalAlignment="Right"
          VerticalAlignment="Center"
          ItemsSource="{Binding PreviewPictures}"
          SelectedItem="{Binding PreviewPicture}">
          <ComboBox.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:PreviewPictureChoice}">
              <StackPanel Orientation="Horizontal">
                <Border
                  Width="72"
                  Height="14"
                  Margin="0,0,10,0"
                  VerticalAlignment="Center"
                  CornerRadius="3">
                  <Border.Background>
                    <ImageBrush ImageSource="{Binding Image}" Stretch="UniformToFill" />
                  </Border.Background>
                </Border>
                <TextBlock VerticalAlignment="Center" Text="{Binding Name}" />
              </StackPanel>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </Grid>
    </Border>
    <Border Style="{StaticResource SettingCard}">
      <Grid>
        <StackPanel Margin="0,0,240,0">
          <TextBlock Text="{l:Tr Settings_StartPage}" />
          <TextBlock Style="{StaticResource Hint}" Text="{l:Tr Settings_StartPageHint}" />
        </StackPanel>
        <ComboBox
          MinWidth="220"
          HorizontalAlignment="Right"
          ItemsSource="{Binding StartPages}"
          SelectedItem="{Binding StartPage}" />
      </Grid>
    </Border>
    <Border Style="{StaticResource SettingCard}">
      <Grid>
        <StackPanel Margin="0,0,80,0">
          <TextBlock Text="{l:Tr Settings_ReduceMotion}" />
          <TextBlock Style="{StaticResource Hint}" Text="{l:Tr Settings_ReduceMotionHint}" />
        </StackPanel>
        <ui:ToggleSwitch HorizontalAlignment="Right" IsChecked="{Binding ReduceMotion}" />
      </Grid>
    </Border>

    <!-- On-screen display -->
    <TextBlock Style="{StaticResource SectionHeader}" Text="{l:Tr Settings_Osd}" />
    <Border Style="{StaticResource SettingCard}">
      <Grid>
        <StackPanel Margin="0,0,80,0">
          <TextBlock Text="{l:Tr Settings_OsdToggle}" />
          <TextBlock Style="{StaticResource Hint}" Text="{l:Tr Settings_OsdHint}" />
        </StackPanel>
        <ui:ToggleSwitch HorizontalAlignment="Right" IsChecked="{Binding ShowOsd}" />
      </Grid>
    </Border>
    <Border Style="{StaticResource SettingCard}">
      <Grid>
        <TextBlock VerticalAlignment="Center" Text="{l:Tr Settings_OsdPosition}" />
        <ComboBox
          MinWidth="220"
          HorizontalAlignment="Right"
          IsEnabled="{Binding ShowOsd}"
          ItemTemplate="{StaticResource EnumItem}"
          ItemsSource="{Binding OsdPositions}"
          SelectedItem="{Binding OsdPosition}" />
      </Grid>
    </Border>
    <Border Style="{StaticResource SettingCard}">
      <Grid>
        <TextBlock VerticalAlignment="Center" Text="{l:Tr Settings_OsdDuration}" />
        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
          <Slider
            Width="200"
            IsEnabled="{Binding ShowOsd}"
            IsSnapToTickEnabled="True"
            Maximum="5"
            Minimum="0.5"
            TickFrequency="0.5"
            Value="{Binding OsdSeconds}" />
          <TextBlock
            Width="48"
            Margin="12,0,0,0"
            VerticalAlignment="Center"
            Text="{Binding OsdSeconds, StringFormat={}{0:0.#} s}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Hotkeys -->
    <TextBlock Style="{StaticResource SectionHeader}" Text="{l:Tr Settings_Hotkeys}" />
    <Border Style="{StaticResource SettingCard}">
      <Grid>
        <StackPanel Margin="0,0,200,0">
          <TextBlock Text="{l:Tr Settings_Pause}" />
          <TextBlock Style="{StaticResource Hint}" Text="{l:Tr Settings_PauseHint}" />
        </StackPanel>
        <ctl:HotkeyBox HorizontalAlignment="Right" Gesture="{Binding PauseHotkey}" />
      </Grid>
    </Border>
    <Border Style="{StaticResource SettingCard}">
      <Grid>
        <TextBlock VerticalAlignment="Center" Text="{l:Tr Settings_Next}" />
        <ctl:HotkeyBox HorizontalAlignment="Right" Gesture="{Binding NextHotkey}" />
      </Grid>
    </Border>
    <Border Style="{StaticResource SettingCard}">
      <Grid>
        <TextBlock VerticalAlignment="Center" Text="{l:Tr Settings_Previous}" />
        <ctl:HotkeyBox HorizontalAlignment="Right" Gesture="{Binding PreviousHotkey}" />
      </Grid>
    </Border>
    <TextBlock
      Margin="2,4,0,0"
      Style="{StaticResource ErrorText}"
      Text="{Binding HotkeyError}"
      Visibility="{Binding HotkeyError, Converter={x:Static ctl:NullToCollapsedConverter.Instance}}" />
  </StackPanel>
</UserControl>
