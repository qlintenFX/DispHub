<UserControl
  x:Class="DispHub.Views.SettingsView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ctl="clr-namespace:DispHub.Controls"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:l="clr-namespace:DispHub.Localization"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:vm="clr-namespace:DispHub.ViewModels"
  d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
  mc:Ignorable="d">
  <UserControl.Resources>
    <DataTemplate x:Key="EnumItem">
      <TextBlock Text="{Binding Converter={x:Static ctl:EnumWordsConverter.Instance}}" />
    </DataTemplate>
  </UserControl.Resources>

  <StackPanel>
    <TextBlock Style="{StaticResource PageTitle}" Text="{l:Tr Settings_Title}" />
    <TextBlock Style="{StaticResource PageSubtitle}" Text="{l:Tr Settings_Subtitle}" />

    <TextBlock Style="{StaticResource SectionHeader}" Text="{l:Tr Settings_General}" />
    <Border Style="{StaticResource SettingCard}">
      <Grid>
        <StackPanel>
          <TextBlock Text="{l:Tr Settings_StartWithWindows}" />
          <TextBlock Style="{StaticResource Hint}" Text="{l:Tr Settings_StartWithWindowsHint}" />
          <TextBlock
            Style="{StaticResource ErrorText}"
            Text="{Binding LaunchAtLoginNote}"
            Visibility="{Binding LaunchAtLoginNote, Converter={x:Static ctl:NullToCollapsedConverter.Instance}}" />
        </StackPanel>
        <ui:ToggleSwitch HorizontalAlignment="Right" IsChecked="{Binding LaunchAtLogin}" />
      </Grid>
    </Border>
    <Border Style="{StaticResource SettingCard}">
      <Grid>
        <StackPanel>
          <TextBlock Text="{l:Tr Settings_KeepRunning}" />
          <TextBlock Style="{StaticResource Hint}" Text="{l:Tr Settings_KeepRunningHint}" />
        </StackPanel>
        <ui:ToggleSwitch HorizontalAlignment="Right" IsChecked="{Binding CloseToTray}" />
      </Grid>
    </Border>
    <Border Style="{StaticResource SettingCard}">
      <Grid>
        <StackPanel>
          <TextBlock Text="{l:Tr Settings_Theme}" />
          <TextBlock Style="{StaticResource Hint}" Text="{l:Tr Settings_ThemeHint}" />
        </StackPanel>
        <ComboBox
          MinWidth="160"
          HorizontalAlignment="Right"
          ItemTemplate="{StaticResource EnumItem}"
          ItemsSource="{Binding Themes}"
          SelectedItem="{Binding Theme}" />
      </Grid>
    </Border>
    <Border Style="{StaticResource SettingCard}">
      <Grid>
        <StackPanel>
          <TextBlock Text="{l:Tr Settings_TrayClick}" />
          <TextBlock Style="{StaticResource Hint}" Text="{l:Tr Settings_TrayClickHint}" />
        </StackPanel>
        <ComboBox
          MinWidth="200"
          HorizontalAlignment="Right"
          ItemTemplate="{StaticResource EnumItem}"
          ItemsSource="{Binding TrayActions}"
          SelectedItem="{Binding TrayLeftClick}" />
      </Grid>
    </Border>

    <Border Style="{StaticResource SettingCard}">
      <Grid>
        <StackPanel Margin="0,0,240,0">
          <TextBlock Text="{l:Tr Settings_Language}" />
          <TextBlock Style="{StaticResource Hint}" Text="{l:Tr Settings_LanguageHint}" />
          <StackPanel
            Margin="0,6,0,0"
            Orientation="Horizontal"
            Visibility="{Binding LanguageNeedsRestart, Converter={StaticResource BoolToVisibility}}">
            <TextBlock
              Margin="0,0,10,0"
              VerticalAlignment="Center"
              Style="{StaticResource Hint}"
              Text="{l:Tr Settings_LanguageRestart}" />
            <ui:Button
              Appearance="Primary"
              Command="{Binding RestartCommand}"
              Content="{l:Tr Settings_RestartNow}" />
          </StackPanel>
        </StackPanel>
        <ComboBox
          MinWidth="200"
          HorizontalAlignment="Right"
          VerticalAlignment="Top"
          ItemsSource="{Binding LanguageChoices}"
          SelectedItem="{Binding Language}" />
      </Grid>
    </Border>

    <TextBlock Style="{StaticResource SectionHeader}" Text="{l:Tr Settings_Osd}" />
    <Border Style="{StaticResource SettingCard}">
      <Grid>
        <StackPanel>
          <TextBlock Text="{l:Tr Settings_OsdToggle}" />
          <TextBlock Style="{StaticResource Hint}" Text="{l:Tr Settings_OsdHint}" />
        </StackPanel>
        <ui:ToggleSwitch HorizontalAlignment="Right" IsChecked="{Binding ShowOsd}" />
      </Grid>
    </Border>
    <Border Style="{StaticResource SettingCard}">
      <Grid>
        <TextBlock VerticalAlignment="Center" Text="{l:Tr Settings_OsdDuration}" />
        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
          <Slider
            Width="200"
            IsEnabled="{Binding ShowOsd}"
            IsSnapToTickEnabled="True"
            Maximum="5"
            Minimum="0.5"
            TickFrequency="0.5"
            Value="{Binding OsdSeconds}" />
          <TextBlock
            Width="48"
            Margin="12,0,0,0"
            VerticalAlignment="Center"
            Text="{Binding OsdSeconds, StringFormat={}{0:0.#} s}" />
        </StackPanel>
      </Grid>
    </Border>

    <TextBlock Style="{StaticResource SectionHeader}" Text="{l:Tr Settings_Hotkeys}" />
    <Border Style="{StaticResource SettingCard}">
      <Grid>
        <StackPanel>
          <TextBlock Text="{l:Tr Settings_Pause}" />
          <TextBlock Style="{StaticResource Hint}" Text="{l:Tr Settings_PauseHint}" />
        </StackPanel>
        <ctl:HotkeyBox HorizontalAlignment="Right" Gesture="{Binding PauseHotkey}" />
      </Grid>
    </Border>
    <Border Style="{StaticResource SettingCard}">
      <Grid>
        <TextBlock VerticalAlignment="Center" Text="{l:Tr Settings_Next}" />
        <ctl:HotkeyBox HorizontalAlignment="Right" Gesture="{Binding NextHotkey}" />
      </Grid>
    </Border>
    <Border Style="{StaticResource SettingCard}">
      <Grid>
        <TextBlock VerticalAlignment="Center" Text="{l:Tr Settings_Previous}" />
        <ctl:HotkeyBox HorizontalAlignment="Right" Gesture="{Binding PreviousHotkey}" />
      </Grid>
    </Border>
    <TextBlock
      Margin="2,4,0,0"
      Style="{StaticResource ErrorText}"
      Text="{Binding HotkeyError}"
      Visibility="{Binding HotkeyError, Converter={x:Static ctl:NullToCollapsedConverter.Instance}}" />

    <TextBlock Style="{StaticResource SectionHeader}" Text="{l:Tr Settings_Displays}" />
    <ItemsControl ItemsSource="{Binding Monitors}">
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="{x:Type vm:MonitorItemViewModel}">
          <Border Style="{StaticResource SettingCard}">
            <Grid>
              <StackPanel>
                <TextBlock Text="{Binding Name}" />
                <TextBlock Style="{StaticResource Hint}" Text="{Binding Details}" />
              </StackPanel>
              <CheckBox
                HorizontalAlignment="Right"
                Content="{l:Tr Settings_LeaveAlone}"
                IsChecked="{Binding Excluded}" />
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <Border Style="{StaticResource SettingCard}">
      <Grid>
        <StackPanel Margin="0,0,180,0">
          <TextBlock Text="{l:Tr Settings_FullRange}" />
          <TextBlock Style="{StaticResource Hint}" Text="{l:Tr Settings_FullRangeHint}" />
        </StackPanel>
        <ui:Button
          HorizontalAlignment="Right"
          Command="{Binding EnableExtendedGammaRangeCommand}"
          Content="{l:Tr Settings_AllowFullRange}"
          Visibility="{Binding ExtendedGammaRange, Converter={x:Static ctl:InverseBoolToVisibilityConverter.Instance}}" />
        <TextBlock
          HorizontalAlignment="Right"
          VerticalAlignment="Center"
          Style="{StaticResource Hint}"
          Text="{l:Tr Common_Enabled}"
          Visibility="{Binding ExtendedGammaRange, Converter={StaticResource BoolToVisibility}}" />
      </Grid>
    </Border>
  </StackPanel>
</UserControl>
