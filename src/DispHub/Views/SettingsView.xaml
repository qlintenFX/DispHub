<UserControl
  x:Class="DispHub.Views.SettingsView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ctl="clr-namespace:DispHub.Controls"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:vm="clr-namespace:DispHub.ViewModels"
  d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
  mc:Ignorable="d">
  <UserControl.Resources>
    <DataTemplate x:Key="EnumItem">
      <TextBlock Text="{Binding Converter={x:Static ctl:EnumWordsConverter.Instance}}" />
    </DataTemplate>
  </UserControl.Resources>

  <StackPanel>
    <TextBlock Style="{StaticResource PageTitle}" Text="Settings" />
    <TextBlock Style="{StaticResource PageSubtitle}" Text="How DispHub starts, looks and responds." />

    <TextBlock Style="{StaticResource SectionHeader}" Text="General" />
    <Border Style="{StaticResource SettingCard}">
      <Grid>
        <StackPanel>
          <TextBlock Text="Start with Windows" />
          <TextBlock Style="{StaticResource Hint}" Text="Starts quietly in the notification area and applies your profile." />
          <TextBlock
            Style="{StaticResource ErrorText}"
            Text="{Binding LaunchAtLoginNote}"
            Visibility="{Binding LaunchAtLoginNote, Converter={x:Static ctl:NullToCollapsedConverter.Instance}}" />
        </StackPanel>
        <ui:ToggleSwitch HorizontalAlignment="Right" IsChecked="{Binding LaunchAtLogin}" />
      </Grid>
    </Border>
    <Border Style="{StaticResource SettingCard}">
      <Grid>
        <StackPanel>
          <TextBlock Text="Keep running when the window is closed" />
          <TextBlock Style="{StaticResource Hint}" Text="Hotkeys and automation keep working from the notification area." />
        </StackPanel>
        <ui:ToggleSwitch HorizontalAlignment="Right" IsChecked="{Binding CloseToTray}" />
      </Grid>
    </Border>
    <Border Style="{StaticResource SettingCard}">
      <Grid>
        <StackPanel>
          <TextBlock Text="App theme" />
          <TextBlock Style="{StaticResource Hint}" Text="System follows your Windows light or dark mode." />
        </StackPanel>
        <ComboBox
          MinWidth="160"
          HorizontalAlignment="Right"
          ItemTemplate="{StaticResource EnumItem}"
          ItemsSource="{Binding Themes}"
          SelectedItem="{Binding Theme}" />
      </Grid>
    </Border>
    <Border Style="{StaticResource SettingCard}">
      <Grid>
        <StackPanel>
          <TextBlock Text="Clicking the tray icon" />
          <TextBlock Style="{StaticResource Hint}" Text="Right-click always shows the profile menu." />
        </StackPanel>
        <ComboBox
          MinWidth="200"
          HorizontalAlignment="Right"
          ItemTemplate="{StaticResource EnumItem}"
          ItemsSource="{Binding TrayActions}"
          SelectedItem="{Binding TrayLeftClick}" />
      </Grid>
    </Border>

    <TextBlock Style="{StaticResource SectionHeader}" Text="On-screen display" />
    <Border Style="{StaticResource SettingCard}">
      <Grid>
        <StackPanel>
          <TextBlock Text="Show the profile name when it changes" />
          <TextBlock Style="{StaticResource Hint}" Text="Appears above the taskbar after a hotkey or tray switch. Never takes focus from games." />
        </StackPanel>
        <ui:ToggleSwitch HorizontalAlignment="Right" IsChecked="{Binding ShowOsd}" />
      </Grid>
    </Border>
    <Border Style="{StaticResource SettingCard}">
      <Grid>
        <TextBlock VerticalAlignment="Center" Text="How long it stays" />
        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
          <Slider
            Width="200"
            IsEnabled="{Binding ShowOsd}"
            IsSnapToTickEnabled="True"
            Maximum="5"
            Minimum="0.5"
            TickFrequency="0.5"
            Value="{Binding OsdSeconds}" />
          <TextBlock
            Width="48"
            Margin="12,0,0,0"
            VerticalAlignment="Center"
            Text="{Binding OsdSeconds, StringFormat={}{0:0.#} s}" />
        </StackPanel>
      </Grid>
    </Border>

    <TextBlock Style="{StaticResource SectionHeader}" Text="Hotkeys" />
    <Border Style="{StaticResource SettingCard}">
      <Grid>
        <StackPanel>
          <TextBlock Text="Pause or resume" />
          <TextBlock Style="{StaticResource Hint}" Text="Switches between your profile and the original colours." />
        </StackPanel>
        <ctl:HotkeyBox HorizontalAlignment="Right" Gesture="{Binding PauseHotkey}" />
      </Grid>
    </Border>
    <Border Style="{StaticResource SettingCard}">
      <Grid>
        <TextBlock VerticalAlignment="Center" Text="Next profile" />
        <ctl:HotkeyBox HorizontalAlignment="Right" Gesture="{Binding NextHotkey}" />
      </Grid>
    </Border>
    <Border Style="{StaticResource SettingCard}">
      <Grid>
        <TextBlock VerticalAlignment="Center" Text="Previous profile" />
        <ctl:HotkeyBox HorizontalAlignment="Right" Gesture="{Binding PreviousHotkey}" />
      </Grid>
    </Border>
    <TextBlock
      Margin="2,4,0,0"
      Style="{StaticResource ErrorText}"
      Text="{Binding HotkeyError}"
      Visibility="{Binding HotkeyError, Converter={x:Static ctl:NullToCollapsedConverter.Instance}}" />

    <TextBlock Style="{StaticResource SectionHeader}" Text="Displays" />
    <ItemsControl ItemsSource="{Binding Monitors}">
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="{x:Type vm:MonitorItemViewModel}">
          <Border Style="{StaticResource SettingCard}">
            <Grid>
              <StackPanel>
                <TextBlock Text="{Binding Name}" />
                <TextBlock Style="{StaticResource Hint}" Text="{Binding Details}" />
              </StackPanel>
              <CheckBox
                HorizontalAlignment="Right"
                Content="Leave this display alone"
                IsChecked="{Binding Excluded}" />
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <Border Style="{StaticResource SettingCard}">
      <Grid>
        <StackPanel Margin="0,0,180,0">
          <TextBlock Text="Full colour range" />
          <TextBlock Style="{StaticResource Hint}" Text="Windows limits how far colours can change, which mostly affects very warm night profiles. Lifting the limit needs administrator approval once." />
        </StackPanel>
        <ui:Button
          HorizontalAlignment="Right"
          Command="{Binding EnableExtendedGammaRangeCommand}"
          Content="Allow full range"
          Visibility="{Binding ExtendedGammaRange, Converter={x:Static ctl:InverseBoolToVisibilityConverter.Instance}}" />
        <TextBlock
          HorizontalAlignment="Right"
          VerticalAlignment="Center"
          Style="{StaticResource Hint}"
          Text="Enabled"
          Visibility="{Binding ExtendedGammaRange, Converter={StaticResource BoolToVisibility}}" />
      </Grid>
    </Border>
  </StackPanel>
</UserControl>
