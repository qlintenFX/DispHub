<UserControl
  x:Class="DispHub.Views.SettingsView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ctl="clr-namespace:DispHub.Controls"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:l="clr-namespace:DispHub.Localization"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:vm="clr-namespace:DispHub.ViewModels"
  d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
  mc:Ignorable="d">
  <UserControl.Resources>
    <DataTemplate x:Key="EnumItem">
      <TextBlock Text="{Binding Converter={x:Static ctl:EnumWordsConverter.Instance}}" />
    </DataTemplate>
    <Style BasedOn="{StaticResource {x:Type ComboBox}}" TargetType="ComboBox">
      <Setter Property="MinWidth" Value="200" />
    </Style>
  </UserControl.Resources>

  <StackPanel>
    <TextBlock Style="{StaticResource PageTitle}" Text="{l:Tr Settings_Title}" />
    <TextBlock Style="{StaticResource PageSubtitle}" Text="{l:Tr Settings_Subtitle}" />

    <!-- General -->
    <ctl:SectionHeader Text="{l:Tr Settings_General}" />
    <ctl:SettingsCard
      Description="{l:Tr Settings_StartWithWindowsHint}"
      Header="{l:Tr Settings_StartWithWindows}"
      Icon="Power24">
      <ui:ToggleSwitch IsChecked="{Binding LaunchAtLogin}" />
      <ctl:SettingsCard.Footer>
        <TextBlock
          Margin="0,10,0,0"
          Style="{StaticResource ErrorText}"
          Text="{Binding LaunchAtLoginNote}"
          Visibility="{Binding LaunchAtLoginNote, Converter={x:Static ctl:NullToCollapsedConverter.Instance}}" />
      </ctl:SettingsCard.Footer>
    </ctl:SettingsCard>
    <ctl:SettingsCard
      Description="{l:Tr Settings_KeepRunningHint}"
      Header="{l:Tr Settings_KeepRunning}"
      Icon="ArrowMinimize24">
      <ui:ToggleSwitch IsChecked="{Binding CloseToTray}" />
    </ctl:SettingsCard>
    <ctl:SettingsCard
      Description="{l:Tr Settings_TrayClickHint}"
      Header="{l:Tr Settings_TrayClick}"
      Icon="CursorClick24">
      <ComboBox
        ItemTemplate="{StaticResource EnumItem}"
        ItemsSource="{Binding TrayActions}"
        SelectedItem="{Binding TrayLeftClick}" />
    </ctl:SettingsCard>
    <ctl:SettingsCard
      Description="{l:Tr Settings_LanguageHint}"
      Header="{l:Tr Settings_Language}"
      Icon="LocalLanguage24">
      <ComboBox ItemsSource="{Binding LanguageChoices}" SelectedItem="{Binding Language}" />
      <ctl:SettingsCard.Footer>
        <StackPanel
          Margin="0,10,0,0"
          Orientation="Horizontal"
          Visibility="{Binding LanguageNeedsRestart, Converter={StaticResource BoolToVisibility}}">
          <TextBlock
            Margin="0,0,10,0"
            VerticalAlignment="Center"
            Style="{StaticResource Hint}"
            Text="{l:Tr Settings_LanguageRestart}" />
          <ui:Button
            Appearance="Primary"
            Command="{Binding RestartCommand}"
            Content="{l:Tr Settings_RestartNow}" />
        </StackPanel>
      </ctl:SettingsCard.Footer>
    </ctl:SettingsCard>

    <ctl:SettingsCard
      Description="{l:Tr Settings_OsdHint}"
      Header="{l:Tr Settings_OsdToggle}"
      Icon="SlideText24">
      <ui:ToggleSwitch IsChecked="{Binding ShowOsd}" />
    </ctl:SettingsCard>
    <ctl:SettingsCard Header="{l:Tr Settings_OsdPosition}" IsEnabled="{Binding ShowOsd}">
      <ComboBox
        ItemTemplate="{StaticResource EnumItem}"
        ItemsSource="{Binding OsdPositions}"
        SelectedItem="{Binding OsdPosition}" />
    </ctl:SettingsCard>
    <ctl:SettingsCard Header="{l:Tr Settings_OsdDuration}" IsEnabled="{Binding ShowOsd}">
      <StackPanel Orientation="Horizontal">
        <Slider
          Width="180"
          VerticalAlignment="Center"
          AutomationProperties.Name="{l:Tr Settings_OsdDuration}"
          IsSnapToTickEnabled="True"
          Maximum="5"
          Minimum="0.5"
          TickFrequency="0.5"
          Value="{Binding OsdSeconds}" />
        <TextBlock
          Width="40"
          Margin="12,0,0,0"
          VerticalAlignment="Center"
          Text="{Binding OsdSeconds, StringFormat={}{0:0.#} s}"
          TextAlignment="Right" />
      </StackPanel>
    </ctl:SettingsCard>

    <!-- Appearance -->
    <ctl:SectionHeader Text="{l:Tr Settings_Appearance}">
      <ui:HyperlinkButton
        Padding="6,2"
        Command="{Binding ResetAppearanceCommand}"
        Content="{l:Tr Settings_ResetAppearance}" />
    </ctl:SectionHeader>
    <ctl:SettingsCard
      Description="{l:Tr Settings_ThemeHint}"
      Header="{l:Tr Settings_Theme}"
      Icon="DarkTheme24">
      <ComboBox
        ItemTemplate="{StaticResource EnumItem}"
        ItemsSource="{Binding Themes}"
        SelectedItem="{Binding Theme}" />
    </ctl:SettingsCard>
    <ctl:SettingsCard
      Description="{l:Tr Settings_AccentHint}"
      Header="{l:Tr Settings_Accent}"
      Icon="Color24">
      <ListBox
        AutomationProperties.Name="{l:Tr Settings_Accent}"
        ItemsSource="{Binding AccentChoices}"
        SelectedItem="{Binding Accent}"
        Style="{StaticResource SwatchList}" />
    </ctl:SettingsCard>
    <ctl:SettingsCard
      Description="{l:Tr Settings_BackdropHint}"
      Header="{l:Tr Settings_Backdrop}"
      Icon="WindowApps24">
      <ComboBox
        ItemTemplate="{StaticResource EnumItem}"
        ItemsSource="{Binding Backdrops}"
        SelectedItem="{Binding Backdrop}" />
    </ctl:SettingsCard>
    <ctl:SettingsCard
      Description="{l:Tr Settings_TextSizeHint}"
      Header="{l:Tr Settings_TextSize}"
      Icon="TextFont24">
      <ComboBox ItemsSource="{Binding TextScales}" SelectedItem="{Binding TextScale}" />
    </ctl:SettingsCard>
    <ctl:SettingsCard
      Description="{l:Tr Settings_CompactNavHint}"
      Header="{l:Tr Settings_CompactNav}"
      Icon="PanelLeft24">
      <ui:ToggleSwitch IsChecked="{Binding CompactNavigation}" />
    </ctl:SettingsCard>
    <ctl:SettingsCard
      Description="{l:Tr Settings_PreviewPictureHint}"
      Header="{l:Tr Settings_PreviewPicture}"
      Icon="Image24">
      <ComboBox ItemsSource="{Binding PreviewPictures}" SelectedItem="{Binding PreviewPicture}">
        <ComboBox.ItemTemplate>
          <DataTemplate DataType="{x:Type vm:PreviewPictureChoice}">
            <StackPanel Orientation="Horizontal">
              <Border
                Width="72"
                Height="14"
                Margin="0,0,10,0"
                VerticalAlignment="Center"
                CornerRadius="3">
                <Border.Background>
                  <ImageBrush ImageSource="{Binding Image}" Stretch="UniformToFill" />
                </Border.Background>
              </Border>
              <TextBlock VerticalAlignment="Center" Text="{Binding Name}" />
            </StackPanel>
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
    </ctl:SettingsCard>
    <ctl:SettingsCard
      Description="{l:Tr Settings_StartPageHint}"
      Header="{l:Tr Settings_StartPage}"
      Icon="Home24">
      <ComboBox ItemsSource="{Binding StartPages}" SelectedItem="{Binding StartPage}" />
    </ctl:SettingsCard>
    <ctl:SettingsCard
      Description="{l:Tr Settings_AnimationsHint}"
      Header="{l:Tr Settings_Animations}"
      Icon="TopSpeed24">
      <ui:ToggleSwitch IsChecked="{Binding Animations}" />
    </ctl:SettingsCard>

    <!-- Hotkeys -->
    <ctl:SectionHeader Text="{l:Tr Settings_Hotkeys}" />
    <ctl:SettingsCard
      Description="{l:Tr Settings_PauseHint}"
      Header="{l:Tr Settings_Pause}"
      Icon="Power24">
      <ctl:HotkeyBox Gesture="{Binding PauseHotkey}" />
    </ctl:SettingsCard>
    <ctl:SettingsCard Header="{l:Tr Settings_Next}" Icon="ArrowRight24">
      <ctl:HotkeyBox Gesture="{Binding NextHotkey}" />
    </ctl:SettingsCard>
    <ctl:SettingsCard Header="{l:Tr Settings_Previous}" Icon="ArrowLeft24">
      <ctl:HotkeyBox Gesture="{Binding PreviousHotkey}" />
    </ctl:SettingsCard>
    <ctl:SettingsCard
      Description="{l:Tr Settings_QuickPanelHotkeyHint}"
      Header="{l:Tr Settings_QuickPanelHotkey}"
      Icon="WindowArrowUp24">
      <ctl:HotkeyBox Gesture="{Binding QuickPanelHotkey}" />
    </ctl:SettingsCard>
    <ctl:SettingsCard
      Description="{l:Tr Settings_EffectsHotkeyHint}"
      Header="{l:Tr Settings_EffectsHotkey}"
      Icon="Sparkle24"
      Visibility="{Binding ShowEffects, Converter={StaticResource BoolToVisibility}}">
      <ctl:HotkeyBox Gesture="{Binding EffectsHotkey}" />
    </ctl:SettingsCard>
    <TextBlock
      Margin="2,4,0,0"
      Style="{StaticResource ErrorText}"
      Text="{Binding HotkeyError}"
      Visibility="{Binding HotkeyError, Converter={x:Static ctl:NullToCollapsedConverter.Instance}}" />

    <!-- Extras -->
    <ctl:SectionHeader Text="{l:Tr Settings_Extras}" />
    <ctl:SettingsCard
      Description="{l:Tr Settings_ShowEffectsHint}"
      Header="{l:Tr Settings_ShowEffects}"
      Icon="Sparkle24">
      <ui:ToggleSwitch IsChecked="{Binding ShowEffects}" />
    </ctl:SettingsCard>
  </StackPanel>
</UserControl>
