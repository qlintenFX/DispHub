<UserControl
  x:Class="DispHub.Views.AboutView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ctl="clr-namespace:DispHub.Controls"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:l="clr-namespace:DispHub.Localization"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:vm="clr-namespace:DispHub.ViewModels"
  d:DataContext="{d:DesignInstance Type=vm:AboutViewModel}"
  mc:Ignorable="d">
  <StackPanel>
    <StackPanel Margin="0,0,0,24" Orientation="Horizontal">
      <Image
        Width="64"
        Height="64"
        Margin="0,0,18,0"
        Source="pack://application:,,,/Assets/DispHub.png" />
      <StackPanel VerticalAlignment="Center">
        <TextBlock Style="{StaticResource PageTitle}" Text="DispHub" />
        <TextBlock Style="{StaticResource Hint}">
          <Run Text="{Binding Edition, Mode=OneWay}" />
          <Run Text="·" />
          <Run Text="{l:Tr About_Version}" />
          <Run Text="{x:Static vm:AboutViewModel.Version}" />
        </TextBlock>
      </StackPanel>
    </StackPanel>

    <Border Style="{StaticResource SettingCard}" Visibility="{Binding CanUpgrade, Converter={StaticResource BoolToVisibility}}">
      <Grid>
        <StackPanel Margin="0,0,140,0">
          <TextBlock FontWeight="SemiBold" Text="DispHub Pro" />
          <TextBlock Style="{StaticResource Hint}" Text="{l:Tr Pro_LongPitch}" />
        </StackPanel>
        <ui:Button
          HorizontalAlignment="Right"
          Appearance="Primary"
          Command="{Binding UpgradeCommand}"
          Content="{l:Tr Common_GetPro}" />
      </Grid>
    </Border>

    <TextBlock Style="{StaticResource SectionHeader}" Text="{l:Tr About_NoteHeader}" />
    <Border Padding="20,16" Style="{StaticResource SettingCard}">
      <StackPanel>
        <TextBlock TextWrapping="Wrap" Text="{l:Tr About_Note1}" />
        <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Text="{l:Tr About_Note2}" />
        <TextBlock Margin="0,10,0,0" FontStyle="Italic" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{l:Tr About_NoteSignature}" />
      </StackPanel>
    </Border>

    <TextBlock Style="{StaticResource SectionHeader}" Text="{l:Tr About_Credits}" />
    <Border Style="{StaticResource SettingCard}">
      <StackPanel>
        <Grid Margin="0,0,0,10">
          <StackPanel Margin="0,0,140,0">
            <TextBlock Text="{l:Tr About_FluentFlyout}" />
            <TextBlock Style="{StaticResource Hint}" Text="{l:Tr About_FluentFlyoutHint}" />
          </StackPanel>
          <ui:HyperlinkButton
            HorizontalAlignment="Right"
            Command="{Binding OpenUrlCommand}"
            CommandParameter="https://github.com/unchihugo/FluentFlyout"
            Content="FluentFlyout" />
        </Grid>
        <Grid Margin="0,0,0,10">
          <StackPanel Margin="0,0,140,0">
            <TextBlock Text="{l:Tr About_WpfUi}" />
            <TextBlock Style="{StaticResource Hint}" Text="{l:Tr About_WpfUiHint}" />
          </StackPanel>
          <ui:HyperlinkButton
            HorizontalAlignment="Right"
            Command="{Binding OpenUrlCommand}"
            CommandParameter="https://github.com/lepoco/wpfui"
            Content="WPF UI" />
        </Grid>
        <Grid>
          <StackPanel Margin="0,0,140,0">
            <TextBlock Text="{l:Tr About_Community}" />
            <TextBlock Style="{StaticResource Hint}" Text="{l:Tr About_CommunityHint}" />
          </StackPanel>
          <ui:HyperlinkButton
            HorizontalAlignment="Right"
            Command="{Binding OpenUrlCommand}"
            CommandParameter="https://github.com/qlintenFX/DispHub/graphs/contributors"
            Content="{l:Tr About_Contributors}" />
        </Grid>
      </StackPanel>
    </Border>

    <TextBlock Style="{StaticResource SectionHeader}" Text="{l:Tr About_Help}" />
    <Border Style="{StaticResource SettingCard}">
      <Grid>
        <StackPanel Margin="0,0,220,0">
          <TextBlock Text="{l:Tr About_Report}" />
          <TextBlock Style="{StaticResource Hint}" Text="{l:Tr About_ReportHint}" />
          <TextBlock Style="{StaticResource Hint}" Text="{Binding CopiedMessage}" />
        </StackPanel>
        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
          <ui:Button
            Margin="0,0,8,0"
            Command="{Binding CopyDiagnosticsCommand}"
            Content="{l:Tr About_CopyDiagnostics}" />
          <ui:Button
            Command="{Binding OpenUrlCommand}"
            CommandParameter="https://github.com/qlintenFX/DispHub/issues/new/choose"
            Content="{l:Tr About_OpenGitHub}" />
        </StackPanel>
      </Grid>
    </Border>
    <Border Style="{StaticResource SettingCard}">
      <Grid>
        <TextBlock VerticalAlignment="Center" Text="{l:Tr About_Logs}" />
        <ui:Button
          HorizontalAlignment="Right"
          Command="{Binding OpenLogsCommand}"
          Content="{l:Tr About_OpenFolder}" />
      </Grid>
    </Border>

    <TextBlock Style="{StaticResource SectionHeader}" Text="{l:Tr About_About}" />
    <Border Style="{StaticResource SettingCard}">
      <StackPanel>
        <TextBlock Style="{StaticResource Hint}" Text="{l:Tr About_Licence}" />
        <WrapPanel Margin="0,10,0,0">
          <ui:HyperlinkButton
            Command="{Binding OpenUrlCommand}"
            CommandParameter="https://github.com/qlintenFX/DispHub"
            Content="{l:Tr About_SourceCode}" />
          <ui:HyperlinkButton
            Command="{Binding OpenUrlCommand}"
            CommandParameter="https://github.com/qlintenFX/DispHub/blob/main/PRIVACY.md"
            Content="{l:Tr About_Privacy}" />
          <ui:HyperlinkButton
            Command="{Binding OpenUrlCommand}"
            CommandParameter="https://github.com/qlintenFX/DispHub/blob/main/THIRD_PARTY_NOTICES.md"
            Content="{l:Tr About_Notices}" />
        </WrapPanel>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
