<UserControl
  x:Class="DispHub.Views.AboutView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ctl="clr-namespace:DispHub.Controls"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:l="clr-namespace:DispHub.Localization"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:vm="clr-namespace:DispHub.ViewModels"
  d:DataContext="{d:DesignInstance Type=vm:AboutViewModel}"
  mc:Ignorable="d">
  <StackPanel>
    <StackPanel Margin="0,0,0,24" Orientation="Horizontal">
      <Image
        Width="64"
        Height="64"
        Margin="0,0,18,0"
        RenderOptions.BitmapScalingMode="HighQuality"
        Source="pack://application:,,,/Assets/DispHub.png" />
      <StackPanel VerticalAlignment="Center">
        <TextBlock Style="{StaticResource PageTitle}" Text="DispHub" />
        <TextBlock Style="{StaticResource Hint}">
          <Run Text="{Binding Edition, Mode=OneWay}" />
          <Run Text="·" />
          <Run Text="{l:Tr About_Version}" />
          <Run Text="{x:Static vm:AboutViewModel.Version}" />
        </TextBlock>
      </StackPanel>
    </StackPanel>

    <ctl:SettingsCard
      Description="{l:Tr Pro_LongPitch}"
      Header="DispHub Pro"
      Icon="Star24"
      Visibility="{Binding CanUpgrade, Converter={StaticResource BoolToVisibility}}">
      <ui:Button
        Appearance="Primary"
        Command="{Binding UpgradeCommand}"
        Content="{l:Tr Common_GetPro}" />
    </ctl:SettingsCard>

    <ctl:SectionHeader Text="{l:Tr About_NoteHeader}" />
    <Border Padding="20,16" Style="{StaticResource SettingCard}">
      <StackPanel>
        <TextBlock TextWrapping="Wrap" Text="{l:Tr About_Note1}" />
        <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Text="{l:Tr About_Note2}" />
        <TextBlock Margin="0,10,0,0" FontStyle="Italic" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{l:Tr About_NoteSignature}" />
      </StackPanel>
    </Border>

    <ctl:SectionHeader Text="{l:Tr About_Credits}" />
    <ctl:SettingsCard Description="{l:Tr About_FluentFlyoutHint}" Header="{l:Tr About_FluentFlyout}">
      <ui:HyperlinkButton
        Command="{Binding OpenUrlCommand}"
        CommandParameter="https://github.com/unchihugo/FluentFlyout"
        Content="FluentFlyout" />
    </ctl:SettingsCard>
    <ctl:SettingsCard Description="{l:Tr About_WpfUiHint}" Header="{l:Tr About_WpfUi}">
      <ui:HyperlinkButton
        Command="{Binding OpenUrlCommand}"
        CommandParameter="https://github.com/lepoco/wpfui"
        Content="WPF UI" />
    </ctl:SettingsCard>
    <ctl:SettingsCard Description="{l:Tr About_CommunityHint}" Header="{l:Tr About_Community}">
      <ui:HyperlinkButton
        Command="{Binding OpenUrlCommand}"
        CommandParameter="https://github.com/qlintenFX/DispHub/graphs/contributors"
        Content="{l:Tr About_Contributors}" />
    </ctl:SettingsCard>

    <ctl:SectionHeader Text="{l:Tr About_Help}" />
    <ctl:SettingsCard
      Description="{l:Tr About_ReportHint}"
      Header="{l:Tr About_Report}"
      Icon="Bug24"
      WrapWidth="640">
      <StackPanel Orientation="Horizontal">
        <ui:Button
          Margin="0,0,8,0"
          Command="{Binding CopyDiagnosticsCommand}">
          <ui:Button.Style>
            <Style BasedOn="{StaticResource {x:Type ui:Button}}" TargetType="ui:Button">
              <Setter Property="Content" Value="{l:Tr About_CopyDiagnostics}" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding Copied}" Value="True">
                  <Setter Property="Content" Value="{l:Tr About_Copied}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </ui:Button.Style>
        </ui:Button>
        <ui:Button
          Command="{Binding OpenUrlCommand}"
          CommandParameter="https://github.com/qlintenFX/DispHub/issues/new/choose"
          Content="{l:Tr About_OpenGitHub}" />
      </StackPanel>
    </ctl:SettingsCard>
    <ctl:SettingsCard Header="{l:Tr About_Logs}" Icon="Folder24">
      <ui:Button Command="{Binding OpenLogsCommand}" Content="{l:Tr About_OpenFolder}" />
    </ctl:SettingsCard>

    <ctl:SectionHeader Text="{l:Tr About_About}" />
    <Border Style="{StaticResource SettingCard}">
      <StackPanel>
        <TextBlock Style="{StaticResource Hint}" Text="{l:Tr About_Licence}" />
        <WrapPanel Margin="0,10,0,0">
          <ui:HyperlinkButton
            Command="{Binding OpenUrlCommand}"
            CommandParameter="https://github.com/qlintenFX/DispHub"
            Content="{l:Tr About_SourceCode}" />
          <ui:HyperlinkButton
            Command="{Binding OpenUrlCommand}"
            CommandParameter="https://github.com/qlintenFX/DispHub/blob/main/PRIVACY.md"
            Content="{l:Tr About_Privacy}" />
          <ui:HyperlinkButton
            Command="{Binding OpenUrlCommand}"
            CommandParameter="https://github.com/qlintenFX/DispHub/blob/main/THIRD_PARTY_NOTICES.md"
            Content="{l:Tr About_Notices}" />
        </WrapPanel>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
