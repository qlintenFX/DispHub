<UserControl
  x:Class="DispHub.Views.DisplaysView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ctl="clr-namespace:DispHub.Controls"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:l="clr-namespace:DispHub.Localization"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:vm="clr-namespace:DispHub.ViewModels"
  d:DataContext="{d:DesignInstance Type=vm:DisplaysViewModel}"
  mc:Ignorable="d">
  <StackPanel>
    <TextBlock Style="{StaticResource PageTitle}" Text="{l:Tr Displays_Title}" />
    <TextBlock Style="{StaticResource PageSubtitle}" Text="{l:Tr Displays_Subtitle}" />

    <ItemsControl ItemsSource="{Binding Displays}">
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="{x:Type vm:DisplayItem}">
          <Border Padding="18,16" Style="{StaticResource SettingCard}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Border
                Width="52"
                Height="52"
                Margin="0,0,16,0"
                VerticalAlignment="Top"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                CornerRadius="10">
                <ui:SymbolIcon FontSize="28" Symbol="Desktop24" />
              </Border>
              <StackPanel Grid.Column="1">
                <StackPanel Orientation="Horizontal">
                  <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding Name}" />
                  <Border
                    Margin="8,0,0,0"
                    Padding="6,1"
                    VerticalAlignment="Center"
                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                    CornerRadius="4"
                    Visibility="{Binding IsPrimary, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock FontSize="11" Text="{l:Tr Displays_Main}" />
                  </Border>
                  <Border
                    Margin="6,0,0,0"
                    Padding="6,1"
                    VerticalAlignment="Center"
                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                    CornerRadius="4"
                    Visibility="{Binding IsHdr, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock FontSize="11" Text="HDR" />
                  </Border>
                </StackPanel>
                <TextBlock Style="{StaticResource Hint}" Text="{Binding Summary}" />
                <WrapPanel Margin="0,10,0,0">
                  <StackPanel Margin="0,0,20,4" Orientation="Horizontal">
                    <ui:SymbolIcon
                      Margin="0,0,6,0"
                      FontSize="16"
                      Symbol="Color24" />
                    <TextBlock VerticalAlignment="Center" Text="{Binding Colours}" />
                  </StackPanel>
                  <StackPanel Margin="0,0,20,4" Orientation="Horizontal">
                    <ui:SymbolIcon
                      Margin="0,0,6,0"
                      FontSize="16"
                      Symbol="Drop24" />
                    <TextBlock VerticalAlignment="Center" Text="{Binding Vibrance}" />
                  </StackPanel>
                </WrapPanel>
                <TextBlock
                  Margin="0,4,0,0"
                  FontSize="11"
                  Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                  Text="{Binding Details}" />
              </StackPanel>
              <StackPanel Grid.Column="2" VerticalAlignment="Top">
                <TextBlock
                  HorizontalAlignment="Right"
                  Style="{StaticResource Hint}"
                  Text="{l:Tr Displays_LeaveAlone}" />
                <ui:ToggleSwitch
                  Margin="0,4,0,0"
                  HorizontalAlignment="Right"
                  IsChecked="{Binding Excluded}" />
              </StackPanel>
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <TextBlock Style="{StaticResource SectionHeader}" Text="{l:Tr Displays_Colours}" />
    <Border Style="{StaticResource SettingCard}">
      <Grid>
        <StackPanel Margin="0,0,200,0">
          <TextBlock Text="{l:Tr Settings_FullRange}" />
          <TextBlock Style="{StaticResource Hint}" Text="{l:Tr Settings_FullRangeHint}" />
        </StackPanel>
        <ui:Button
          HorizontalAlignment="Right"
          Command="{Binding EnableExtendedGammaRangeCommand}"
          Content="{l:Tr Settings_AllowFullRange}"
          Visibility="{Binding ExtendedGammaRange, Converter={x:Static ctl:InverseBoolToVisibilityConverter.Instance}}" />
        <TextBlock
          HorizontalAlignment="Right"
          VerticalAlignment="Center"
          Style="{StaticResource Hint}"
          Text="{l:Tr Common_Enabled}"
          Visibility="{Binding ExtendedGammaRange, Converter={StaticResource BoolToVisibility}}" />
      </Grid>
    </Border>
  </StackPanel>
</UserControl>
