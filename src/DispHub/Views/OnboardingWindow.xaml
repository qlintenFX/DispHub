<ui:FluentWindow
  x:Class="DispHub.Views.OnboardingWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ctl="clr-namespace:DispHub.Controls"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:l="clr-namespace:DispHub.Localization"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:vm="clr-namespace:DispHub.ViewModels"
  Title="DispHub"
  Width="580"
  Height="500"
  d:DataContext="{d:DesignInstance Type=vm:OnboardingViewModel}"
  ExtendsContentIntoTitleBar="True"
  Icon="pack://application:,,,/Assets/DispHub.ico"
  ResizeMode="NoResize"
  WindowBackdropType="Mica"
  WindowCornerPreference="Round"
  WindowStartupLocation="CenterScreen"
  mc:Ignorable="d">
  <ui:FluentWindow.Resources>
    <Style x:Key="StepTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="24" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style x:Key="StepText" TargetType="TextBlock">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="LineHeight" Value="20" />
    </Style>
    <DataTemplate x:Key="EnumItem">
      <TextBlock Text="{Binding Converter={x:Static ctl:EnumWordsConverter.Instance}}" />
    </DataTemplate>
  </ui:FluentWindow.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ui:TitleBar
      Title="DispHub"
      ShowMaximize="False"
      ShowMinimize="False">
      <ui:TitleBar.Icon>
        <ui:ImageIcon Source="pack://application:,,,/Assets/DispHub-64.png" />
      </ui:TitleBar.Icon>
    </ui:TitleBar>

    <Grid Grid.Row="1" Margin="36,12,36,0">
      <!-- 1. What DispHub does -->
      <StackPanel Visibility="{Binding IsWelcome, Converter={StaticResource BoolToVisibility}}">
        <Image
          Width="72"
          Height="72"
          Margin="0,8,0,20"
          HorizontalAlignment="Left"
          RenderOptions.BitmapScalingMode="HighQuality"
          Source="pack://application:,,,/Assets/DispHub-64.png" />
        <TextBlock Style="{StaticResource StepTitle}" Text="{l:Tr Onboarding_WelcomeTitle}" />
        <TextBlock Style="{StaticResource StepText}" Text="{l:Tr Onboarding_WelcomeText}" />
      </StackPanel>

      <!-- 2. Where DispHub lives, and what a left or right click does -->
      <StackPanel Visibility="{Binding IsTray, Converter={StaticResource BoolToVisibility}}">
        <TextBlock Style="{StaticResource StepTitle}" Text="{l:Tr Onboarding_TrayTitle}" />
        <TextBlock Style="{StaticResource StepText}" Text="{l:Tr Onboarding_TrayText}" />
        <ctl:SettingsCard
          Margin="0,20,0,4"
          Description="{l:Tr Onboarding_LeftClickHint}"
          Header="{l:Tr Onboarding_LeftClick}"
          Icon="CursorClick24">
          <ComboBox
            MinWidth="190"
            ItemTemplate="{StaticResource EnumItem}"
            ItemsSource="{Binding TrayActions}"
            SelectedItem="{Binding TrayLeftClick}" />
        </ctl:SettingsCard>
        <ctl:SettingsCard
          Description="{l:Tr Onboarding_RightClickHint}"
          Header="{l:Tr Onboarding_RightClick}"
          Icon="TextBulletListSquare24" />
      </StackPanel>

      <!-- 3. Hotkeys -->
      <StackPanel Visibility="{Binding IsHotkeys, Converter={StaticResource BoolToVisibility}}">
        <TextBlock Style="{StaticResource StepTitle}" Text="{l:Tr Onboarding_HotkeysTitle}" />
        <TextBlock Style="{StaticResource StepText}" Text="{l:Tr Onboarding_HotkeysText}" />
        <Border Margin="0,20,0,0" Style="{StaticResource SettingCard}">
          <ItemsControl ItemsSource="{Binding Hotkeys}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:HotkeyLine}">
                <DockPanel Margin="0,4">
                  <Border
                    Padding="8,2"
                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    DockPanel.Dock="Right">
                    <TextBlock FontFamily="Cascadia Mono, Consolas" Text="{Binding Keys}" />
                  </Border>
                  <TextBlock VerticalAlignment="Center" Text="{Binding Name}" />
                </DockPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>
      </StackPanel>

      <!-- 4. The power button, and starting with Windows -->
      <StackPanel Visibility="{Binding IsPower, Converter={StaticResource BoolToVisibility}}">
        <TextBlock Style="{StaticResource StepTitle}" Text="{l:Tr Onboarding_PowerTitle}" />
        <TextBlock Style="{StaticResource StepText}" Text="{l:Tr Onboarding_PowerText}" />
        <ctl:SettingsCard
          Margin="0,20,0,0"
          Description="{l:Tr Settings_StartWithWindowsHint}"
          Header="{l:Tr Settings_StartWithWindows}"
          Icon="Power24">
          <ui:ToggleSwitch IsChecked="{Binding LaunchAtLogin}" />
        </ctl:SettingsCard>
      </StackPanel>
    </Grid>

    <!-- Steps and buttons: always in the same place. -->
    <Grid Grid.Row="2" Margin="36,12,36,24">
      <ItemsControl VerticalAlignment="Center" ItemsSource="{Binding Dots}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type vm:StepDot}">
            <Ellipse
              Width="7"
              Height="7"
              Margin="0,0,7,0">
              <Ellipse.Style>
                <Style TargetType="Ellipse">
                  <Setter Property="Fill" Value="{DynamicResource ControlStrongFillColorDisabledBrush}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                      <Setter Property="Fill" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Ellipse.Style>
            </Ellipse>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
        <ui:Button
          MinWidth="90"
          Margin="0,0,8,0"
          Command="{Binding BackCommand}"
          Content="{l:Tr Onboarding_Back}"
          Visibility="{Binding IsFirst, Converter={x:Static ctl:InverseBoolToHiddenConverter.Instance}}" />
        <ui:Button
          MinWidth="110"
          Appearance="Primary"
          Command="{Binding NextCommand}">
          <ui:Button.Style>
            <Style BasedOn="{StaticResource {x:Type ui:Button}}" TargetType="ui:Button">
              <Setter Property="Content" Value="{l:Tr Onboarding_Next}" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsLast}" Value="True">
                  <Setter Property="Content" Value="{l:Tr Onboarding_Done}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </ui:Button.Style>
        </ui:Button>
      </StackPanel>
    </Grid>
  </Grid>
</ui:FluentWindow>
