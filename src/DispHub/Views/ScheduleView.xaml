<UserControl
  x:Class="DispHub.Views.ScheduleView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ctl="clr-namespace:DispHub.Controls"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:l="clr-namespace:DispHub.Localization"
  xmlns:sch="clr-namespace:DispHub.Core.Schedule;assembly=DispHub.Core"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:vm="clr-namespace:DispHub.ViewModels"
  d:DataContext="{d:DesignInstance Type=vm:ScheduleViewModel}"
  mc:Ignorable="d">
  <UserControl.Resources>
    <Style BasedOn="{StaticResource {x:Type ComboBox}}" TargetType="ComboBox">
      <Setter Property="MinWidth" Value="200" />
    </Style>
    <Style BasedOn="{StaticResource {x:Type RadioButton}}" TargetType="RadioButton">
      <Setter Property="Margin" Value="0,6" />
    </Style>
  </UserControl.Resources>

  <StackPanel>
    <Grid>
      <TextBlock Style="{StaticResource PageTitle}" Text="{l:Tr Schedule_Title}" />
      <ui:ToggleSwitch
        HorizontalAlignment="Right"
        VerticalAlignment="Center"
        Content="{Binding Enabled, Converter={x:Static ctl:OnOffConverter.Instance}}"
        IsChecked="{Binding Enabled}" />
    </Grid>
    <TextBlock Style="{StaticResource PageSubtitle}" Text="{Binding StatusText}" />

    <ui:InfoBar
      Title="DispHub Pro"
      Margin="0,0,0,12"
      IsClosable="False"
      IsOpen="True"
      Message="{l:Tr Schedule_ProHint}"
      Severity="Informational"
      Visibility="{Binding IsPro, Converter={x:Static ctl:InverseBoolToVisibilityConverter.Instance}}" />

    <!-- When: like Night light in Windows Settings. -->
    <Border
      Padding="18,8,18,10"
      ctl:Tour.Stop="schedule"
      Style="{StaticResource SettingCard}">
      <StackPanel>
        <RadioButton Content="{l:Tr Schedule_SunsetToSunrise}" IsChecked="{Binding IsSunMode}" />
        <StackPanel Margin="28,0,0,4" Visibility="{Binding IsSunMode, Converter={StaticResource BoolToVisibility}}">
          <DockPanel>
            <ui:HyperlinkButton
              Padding="6,2"
              Command="{Binding EditPlaceCommand}"
              Content="{l:Tr Schedule_ChangePlace}"
              DockPanel.Dock="Right" />
            <ui:SymbolIcon
              Margin="0,0,6,0"
              VerticalAlignment="Center"
              FontSize="16"
              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
              Symbol="Location16" />
            <TextBlock
              VerticalAlignment="Center"
              Style="{StaticResource Hint}"
              Text="{Binding SunText}"
              TextWrapping="Wrap" />
          </DockPanel>
        </StackPanel>
        <RadioButton Content="{l:Tr Schedule_SetHours}" IsChecked="{Binding IsHoursMode}" />
        <RadioButton Content="{l:Tr Schedule_Custom}" IsChecked="{Binding IsCustomMode}" />
      </StackPanel>
    </Border>

    <!-- Where sunrise and sunset are worked out for. -->
    <Border Style="{StaticResource SettingCard}" Visibility="{Binding IsEditingPlace, Converter={StaticResource BoolToVisibility}}">
      <StackPanel>
        <DockPanel>
          <ui:Button
            Margin="8,0,0,0"
            Command="{Binding UseMyLocationCommand}"
            Content="{l:Tr Schedule_UseMyLocation}"
            DockPanel.Dock="Right"
            Icon="{ui:SymbolIcon Location24}" />
          <ui:ProgressRing
            Width="18"
            Height="18"
            Margin="8,0,0,0"
            DockPanel.Dock="Right"
            IsIndeterminate="True"
            Visibility="{Binding IsLocating, Converter={StaticResource BoolToVisibility}}" />
          <ui:TextBox
            Icon="{ui:SymbolIcon Search24}"
            PlaceholderText="{l:Tr Schedule_SearchCity}"
            Text="{Binding LocationQuery, UpdateSourceTrigger=PropertyChanged}" />
        </DockPanel>
        <TextBlock
          Margin="0,6,0,0"
          Style="{StaticResource ErrorText}"
          Text="{Binding LocationError}"
          Visibility="{Binding LocationError, Converter={x:Static ctl:NullToCollapsedConverter.Instance}}" />
        <ItemsControl Margin="0,4,0,0" ItemsSource="{Binding LocationResults}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type sch:Place}">
              <ui:Button
                Margin="0,4,6,0"
                Command="{Binding DataContext.ChoosePlaceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                CommandParameter="{Binding}"
                Icon="{ui:SymbolIcon Location24}">
                <TextBlock>
                  <Run Text="{Binding Name, Mode=OneWay}" />
                  <Run Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding Country, Mode=OneWay}" />
                </TextBlock>
              </ui:Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock
          Margin="0,6,0,0"
          Style="{StaticResource Hint}"
          Text="{l:Tr Schedule_LocationHint}" />
      </StackPanel>
    </Border>

    <!-- Set hours -->
    <StackPanel Visibility="{Binding IsHoursMode, Converter={StaticResource BoolToVisibility}}">
      <ctl:SettingsCard Header="{l:Tr Schedule_TurnOn}" Icon="WeatherMoon24">
        <ctl:TimePicker Time="{Binding TurnOn}" />
      </ctl:SettingsCard>
      <ctl:SettingsCard Header="{l:Tr Schedule_TurnOff}" Icon="WeatherSunny24">
        <ctl:TimePicker Time="{Binding TurnOff}" />
      </ctl:SettingsCard>
    </StackPanel>

    <!-- Night and day profiles, for both simple modes. -->
    <StackPanel Visibility="{Binding IsSimpleMode, Converter={StaticResource BoolToVisibility}}">
      <ctl:SettingsCard
        Description="{l:Tr Schedule_NightProfileHint}"
        Header="{l:Tr Schedule_NightProfile}"
        Icon="WeatherMoon24">
        <ComboBox ItemsSource="{Binding ProfileChoices}" SelectedItem="{Binding NightProfile}" />
      </ctl:SettingsCard>
      <ctl:SettingsCard
        Description="{l:Tr Schedule_DayProfileHint}"
        Header="{l:Tr Schedule_DayProfile}"
        Icon="WeatherSunny24">
        <ComboBox ItemsSource="{Binding ProfileChoices}" SelectedItem="{Binding DayProfile}" />
      </ctl:SettingsCard>
    </StackPanel>

    <!-- Custom: a plain list of changes. -->
    <StackPanel Visibility="{Binding IsCustomMode, Converter={StaticResource BoolToVisibility}}">
      <ctl:SectionHeader Text="{l:Tr Schedule_Changes}">
        <ui:Button
          Command="{Binding AddChangeCommand}"
          Content="{l:Tr Schedule_AddSlot}"
          Icon="{ui:SymbolIcon Add20}" />
      </ctl:SectionHeader>
      <ItemsControl ItemsSource="{Binding Changes}">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type vm:ScheduleChangeItem}">
            <Border Padding="14,8,8,4" Style="{StaticResource SelectableCard}">
              <Border.InputBindings>
                <MouseBinding Command="{Binding SelectCommand}" MouseAction="LeftClick" />
              </Border.InputBindings>
              <DockPanel>
                <ui:Button
                  Width="32"
                  Height="32"
                  Margin="4,0,0,4"
                  Padding="0"
                  VerticalAlignment="Top"
                  Appearance="Transparent"
                  Command="{Binding RemoveCommand}"
                  DockPanel.Dock="Right"
                  Icon="{ui:SymbolIcon Dismiss16}"
                  ToolTip="{l:Tr Schedule_Remove}"
                  AutomationProperties.Name="{l:Tr Schedule_Remove}" />
                <WrapPanel>
                  <ComboBox
                    MinWidth="150"
                    Margin="0,0,8,4"
                    AutomationProperties.Name="{l:Tr Schedule_Starts}"
                    ItemsSource="{Binding Whens}"
                    SelectedItem="{Binding When}" />
                  <ctl:TimePicker
                    Margin="0,0,8,4"
                    Time="{Binding Time}"
                    Visibility="{Binding IsTimeAnchor, Converter={StaticResource BoolToVisibility}}" />
                  <ComboBox
                    MinWidth="170"
                    Margin="0,0,8,4"
                    AutomationProperties.Name="{l:Tr Schedule_Profile}"
                    ItemsSource="{Binding Profiles}"
                    SelectedItem="{Binding Profile}" />
                  <ComboBox
                    MinWidth="150"
                    Margin="0,0,8,4"
                    AutomationProperties.Name="{l:Tr Schedule_On}"
                    ItemsSource="{Binding DaysChoices}"
                    SelectedItem="{Binding DaysChoice}" />
                </WrapPanel>
              </DockPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <DockPanel Margin="4,4,0,0" Visibility="{Binding UsesSun, Converter={StaticResource BoolToVisibility}}">
        <ui:HyperlinkButton
          Padding="6,2"
          Command="{Binding EditPlaceCommand}"
          Content="{l:Tr Schedule_ChangePlace}"
          DockPanel.Dock="Right" />
        <ui:SymbolIcon
          Margin="0,0,6,0"
          VerticalAlignment="Center"
          FontSize="16"
          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
          Symbol="Location16" />
        <TextBlock
          VerticalAlignment="Center"
          Style="{StaticResource Hint}"
          Text="{Binding SunText}"
          TextWrapping="Wrap" />
      </DockPanel>
    </StackPanel>

    <ctl:SettingsCard
      Margin="0,4,0,0"
      Description="{l:Tr Schedule_FadeHint}"
      Header="{l:Tr Schedule_Fade}"
      Icon="ArrowSync24">
      <ComboBox ItemsSource="{Binding Fades}" SelectedItem="{Binding Fade}" />
    </ctl:SettingsCard>

    <!-- What today looks like. -->
    <ctl:SectionHeader Text="{l:Tr Schedule_TodayTitle}" />
    <Border Padding="18,12,18,14" Style="{StaticResource SettingCard}">
      <ctl:DayTimeline
        Now="{Binding Now}"
        Segments="{Binding Segments}"
        SelectedSlot="{Binding SelectedSlotId}"
        Sunrise="{Binding Sunrise}"
        Sunset="{Binding Sunset}" />
    </Border>
  </StackPanel>
</UserControl>
