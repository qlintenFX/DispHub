<UserControl
  x:Class="DispHub.Views.AutomationView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ctl="clr-namespace:DispHub.Controls"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:l="clr-namespace:DispHub.Localization"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:vm="clr-namespace:DispHub.ViewModels"
  x:Name="Root"
  d:DataContext="{d:DesignInstance Type=vm:AutomationViewModel}"
  mc:Ignorable="d">
  <StackPanel>
    <TextBlock Style="{StaticResource PageTitle}" Text="{l:Tr Automation_Title}" />
    <TextBlock Style="{StaticResource PageSubtitle}" Text="{l:Tr Automation_Subtitle}" />

    <Border Style="{StaticResource SettingCard}" Visibility="{Binding IsPro, Converter={x:Static ctl:InverseBoolToVisibilityConverter.Instance}}">
      <Grid>
        <StackPanel Margin="0,0,140,0">
          <TextBlock FontWeight="SemiBold" Text="{l:Tr Automation_ProTitle}" />
          <TextBlock Style="{StaticResource Hint}" Text="{l:Tr Automation_ProExample}" />
        </StackPanel>
        <ui:Button
          HorizontalAlignment="Right"
          Appearance="Primary"
          Command="{Binding UpgradeCommand}"
          Content="{l:Tr Common_GetPro}" />
      </Grid>
    </Border>

    <TextBlock Style="{StaticResource SectionHeader}" Text="{l:Tr Automation_AppsHeader}" />
    <TextBlock
      Margin="2,0,0,8"
      Style="{StaticResource Hint}"
      Text="{l:Tr Automation_AppsHint}" />
    <ItemsControl ItemsSource="{Binding AppRules}">
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="{x:Type vm:AppRuleViewModel}">
          <Border Style="{StaticResource SettingCard}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <ui:ToggleSwitch Margin="0,0,12,0" IsChecked="{Binding Enabled}" />
              <ui:TextBox
                Grid.Column="1"
                Margin="0,0,12,0"
                PlaceholderText="game.exe"
                ctl:CommitOnEnter.IsEnabled="True"
                Text="{Binding Executable, UpdateSourceTrigger=LostFocus}" />
              <ComboBox
                Grid.Column="2"
                DisplayMemberPath="Name"
                ItemsSource="{Binding Choices}"
                SelectedItem="{Binding Profile}" />
              <ui:Button
                Grid.Column="3"
                Margin="8,0,0,0"
                Command="{Binding RemoveCommand}"
                Icon="{ui:SymbolIcon Delete24}"
                ToolTip="{l:Tr Common_Remove}" />
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
      <ui:Button
        Margin="0,0,8,0"
        Command="{Binding AddAppRuleCommand}"
        Content="{l:Tr Automation_AddApp}"
        Icon="{ui:SymbolIcon Add24}" />
      <ui:DropDownButton Content="{l:Tr Automation_AddRunningApp}" Icon="{ui:SymbolIcon AppsList24}">
        <ui:DropDownButton.Flyout>
          <ContextMenu x:Name="RunningAppsMenu" Opened="RunningAppsMenu_Opened" />
        </ui:DropDownButton.Flyout>
      </ui:DropDownButton>
    </StackPanel>

    <TextBlock Style="{StaticResource SectionHeader}" Text="{l:Tr Automation_ScheduleHeader}" />
    <Border Style="{StaticResource SettingCard}">
      <Grid>
        <StackPanel>
          <TextBlock Text="{l:Tr Automation_ScheduleToggle}" />
          <TextBlock Style="{StaticResource Hint}" Text="{l:Tr Automation_ScheduleHint}" />
        </StackPanel>
        <ui:ToggleSwitch HorizontalAlignment="Right" IsChecked="{Binding ScheduleEnabled}" />
      </Grid>
    </Border>
    <ItemsControl ItemsSource="{Binding Slots}">
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="{x:Type vm:ScheduleSlotViewModel}">
          <Border Style="{StaticResource SettingCard}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock
                Margin="0,0,10,0"
                VerticalAlignment="Center"
                Text="{l:Tr Automation_From}" />
              <ui:TextBox
                Grid.Column="1"
                PlaceholderText="21:30"
                ctl:CommitOnEnter.IsEnabled="True"
                Text="{Binding Start, UpdateSourceTrigger=LostFocus}" />
              <ComboBox
                Grid.Column="2"
                Margin="12,0"
                DisplayMemberPath="Name"
                ItemsSource="{Binding Choices}"
                SelectedItem="{Binding Profile}" />
              <StackPanel
                Grid.Column="3"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <TextBlock
                  Margin="0,0,8,0"
                  VerticalAlignment="Center"
                  Text="{l:Tr Automation_Fade}" />
                <ui:NumberBox
                  Width="96"
                  ClearButtonEnabled="False"
                  Maximum="180"
                  MaxDecimalPlaces="0"
                  Minimum="0"
                  SmallChange="5"
                  SpinButtonPlacementMode="Hidden"
                  Value="{Binding FadeMinutes}" />
                <TextBlock
                  Margin="6,0,0,0"
                  VerticalAlignment="Center"
                  Text="{l:Tr Automation_Minutes}" />
              </StackPanel>
              <ui:Button
                Grid.Column="4"
                Margin="8,0,0,0"
                Command="{Binding RemoveCommand}"
                Icon="{ui:SymbolIcon Delete24}"
                ToolTip="{l:Tr Common_Remove}" />
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <ui:Button
      Margin="0,4,0,0"
      Command="{Binding AddSlotCommand}"
      Content="{l:Tr Automation_AddSlot}"
      Icon="{ui:SymbolIcon Add24}" />
  </StackPanel>
</UserControl>
