<UserControl
  x:Class="DispHub.Views.HomeView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ctl="clr-namespace:DispHub.Controls"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:l="clr-namespace:DispHub.Localization"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:vm="clr-namespace:DispHub.ViewModels"
  d:DataContext="{d:DesignInstance Type=vm:HomeViewModel}"
  mc:Ignorable="d">
  <UserControl.Resources>
    <!-- A small "Pro" label for features this user doesn't have yet. -->
    <Style x:Key="ProBadge" TargetType="Border">
      <Setter Property="Margin" Value="8,0,0,0" />
      <Setter Property="Padding" Value="6,1" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>
  </UserControl.Resources>

  <StackPanel>
    <TextBlock Style="{StaticResource PageTitle}" Text="{l:Tr Home_Title}" />

    <!-- What's on the screen now, and why. -->
    <Border
      x:Name="NowCard"
      Margin="0,8,0,0"
      Padding="0"
      ctl:Tour.Stop="now"
      Style="{StaticResource SettingCard}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <!-- The picture in the current profile's colours, with DispHub's wordmark on it. -->
        <Border
          Width="264"
          Height="165"
          CornerRadius="7,0,0,7">
          <Border.Background>
            <ImageBrush
              ImageSource="{Binding NowPicture}"
              RenderOptions.BitmapScalingMode="HighQuality"
              Stretch="UniformToFill" />
          </Border.Background>
          <!--
            Acrylic behind the wordmark, as Windows draws its flyouts: the same picture blurred, a dark tint and a
            light edge.
          -->
          <Grid
            Width="224"
            Height="72"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
            <Grid.Clip>
              <RectangleGeometry
                RadiusX="10"
                RadiusY="10"
                Rect="0,0,224,72" />
            </Grid.Clip>
            <Rectangle
              Width="264"
              Height="165"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
              <Rectangle.Fill>
                <ImageBrush ImageSource="{Binding NowPicture}" Stretch="UniformToFill" />
              </Rectangle.Fill>
              <Rectangle.Effect>
                <BlurEffect
                  KernelType="Gaussian"
                  Radius="30"
                  RenderingBias="Quality" />
              </Rectangle.Effect>
            </Rectangle>
            <Border
              Background="#1F14171E"
              BorderBrush="#40FFFFFF"
              BorderThickness="1"
              CornerRadius="10" />
            <!-- "DispHub" sits level with the monitor's screen, above the image's middle: lowered to the panel's. -->
            <Image
              Width="196"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              RenderOptions.BitmapScalingMode="HighQuality"
              Source="pack://application:,,,/Assets/wordmark.png">
              <Image.RenderTransform>
                <TranslateTransform X="1" Y="3.5" />
              </Image.RenderTransform>
            </Image>
          </Grid>
        </Border>
        <StackPanel
          Grid.Column="1"
          Margin="24,16"
          VerticalAlignment="Center">
          <TextBlock Style="{StaticResource Hint}" Text="{l:Tr Home_Now}" />
          <TextBlock
            Margin="0,2,0,0"
            FontSize="28"
            FontWeight="SemiBold"
            Text="{Binding NowName}"
            TextTrimming="CharacterEllipsis" />
          <TextBlock
            Margin="0,4,0,0"
            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
            Text="{Binding NowReason}"
            TextWrapping="Wrap" />
          <ui:Button
            Margin="0,12,0,0"
            Appearance="Primary"
            Command="{Binding TurnOnCommand}"
            Content="{l:Tr Power_TurnOn}"
            Icon="{ui:SymbolIcon Power24}"
            Visibility="{Binding IsOn, Converter={x:Static ctl:InverseBoolToVisibilityConverter.Instance}}" />
          <ui:Button
            Margin="0,12,0,0"
            Appearance="Primary"
            Command="{Binding TurnProfilesOnCommand}"
            Content="{l:Tr Home_TurnProfilesOn}"
            Icon="{ui:SymbolIcon Color24}"
            Visibility="{Binding ProfilesOff, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Today on the schedule, or the offer of one. -->
    <ctl:SectionHeader Text="{l:Tr Home_Today}">
      <ui:HyperlinkButton Command="{Binding OpenScheduleCommand}" Content="{l:Tr Home_EditSchedule}" />
    </ctl:SectionHeader>
    <Border
      Padding="16,12,16,14"
      Style="{StaticResource SettingCard}"
      Visibility="{Binding ShowToday, Converter={StaticResource BoolToVisibility}}">
      <StackPanel>
        <TextBlock
          Margin="0,0,0,10"
          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
          Text="{Binding TodayText}" />
        <ctl:DayTimeline Now="{Binding TodayNow}" Segments="{Binding TodaySegments}" />
      </StackPanel>
    </Border>
    <ctl:SettingsCard
      Description="{l:Tr Home_NoScheduleHint}"
      Header="{l:Tr Home_NoSchedule}"
      Icon="Clock24"
      Visibility="{Binding ShowToday, Converter={x:Static ctl:InverseBoolToVisibilityConverter.Instance}}">
      <ui:Button Command="{Binding OpenScheduleCommand}" Content="{l:Tr Home_SetUpSchedule}" />
    </ctl:SettingsCard>
    <!-- Where each feature stands. -->
    <ctl:SectionHeader Text="{l:Tr Home_Features}" />
    <ItemsControl ctl:Tour.Stop="features" ItemsSource="{Binding Features}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <UniformGrid Margin="-4,-4,-4,0" Columns="2" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="{x:Type vm:HomeFeature}">
          <ui:CardAction
            Margin="4"
            Padding="16,14"
            Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
            CommandParameter="{Binding}"
            IsChevronVisible="True">
            <ui:CardAction.Icon>
              <ui:SymbolIcon FontSize="24" Symbol="{Binding Icon}" />
            </ui:CardAction.Icon>
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                <Border Style="{StaticResource ProBadge}" Visibility="{Binding NeedsPro, Converter={StaticResource BoolToVisibility}}">
                  <TextBlock
                    FontSize="11"
                    Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                    Text="Pro" />
                </Border>
              </StackPanel>
              <TextBlock
                Margin="0,2,0,0"
                Text="{Binding Status}"
                TextTrimming="CharacterEllipsis">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsActive}" Value="False">
                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </StackPanel>
          </ui:CardAction>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- What Pro adds, for free users in the Store build. -->
    <ctl:SettingsCard
      Margin="0,16,0,0"
      Description="{l:Tr Pro_LongPitch}"
      Header="DispHub Pro"
      Icon="Star24"
      Visibility="{Binding ShowPro, Converter={StaticResource BoolToVisibility}}">
      <ui:Button
        Appearance="Primary"
        Command="{Binding UpgradeCommand}"
        Content="{l:Tr Common_GetPro}" />
    </ctl:SettingsCard>

    <WrapPanel Margin="-12,20,0,0">
      <ui:HyperlinkButton
        Command="{Binding TourCommand}"
        Content="{l:Tr Home_Tour}"
        Icon="{ui:SymbolIcon Lightbulb24}" />
      <ui:HyperlinkButton
        Command="{Binding OpenUrlCommand}"
        CommandParameter="{x:Static vm:HomeViewModel.ChangelogUrl}"
        Content="{l:Tr Home_WhatsNew}"
        Icon="{ui:SymbolIcon News24}" />
      <ui:HyperlinkButton
        Command="{Binding RateCommand}"
        Content="{l:Tr Home_Rate}"
        Icon="{ui:SymbolIcon Star24}"
        Visibility="{Binding CanRate, Converter={StaticResource BoolToVisibility}}" />
      <ui:HyperlinkButton
        Command="{Binding OpenUrlCommand}"
        CommandParameter="https://github.com/qlintenFX/DispHub/issues/new/choose"
        Content="{l:Tr Home_Report}"
        Icon="{ui:SymbolIcon Bug24}" />
      <ui:HyperlinkButton
        Command="{Binding OpenUrlCommand}"
        CommandParameter="https://github.com/qlintenFX/DispHub"
        Content="{l:Tr Home_GitHub}"
        Icon="{ui:SymbolIcon Code24}" />
    </WrapPanel>
    <TextBlock
      Margin="0,8,0,0"
      Style="{StaticResource Hint}"
      Text="{x:Static vm:HomeViewModel.Version}" />
  </StackPanel>
</UserControl>
