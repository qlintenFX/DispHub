<UserControl
  x:Class="DispHub.Views.AppsView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ctl="clr-namespace:DispHub.Controls"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:l="clr-namespace:DispHub.Localization"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:vm="clr-namespace:DispHub.ViewModels"
  d:DataContext="{d:DesignInstance Type=vm:AppsViewModel}"
  mc:Ignorable="d">
  <StackPanel>
    <TextBlock Style="{StaticResource PageTitle}" Text="{l:Tr Apps_Title}" />
    <TextBlock Style="{StaticResource PageSubtitle}" Text="{l:Tr Apps_Subtitle}" />

    <ui:InfoBar
      Title="DispHub Pro"
      Margin="0,0,0,12"
      IsClosable="False"
      IsOpen="True"
      Message="{l:Tr Apps_ProHint}"
      Severity="Informational"
      Visibility="{Binding IsPro, Converter={x:Static ctl:InverseBoolToVisibilityConverter.Instance}}" />

    <!-- What's in front -->
    <Border Padding="16,14" Style="{StaticResource SettingCard}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Border
          Width="44"
          Height="44"
          Margin="0,0,14,0"
          Background="{DynamicResource ControlFillColorSecondaryBrush}"
          CornerRadius="8">
          <Image
            Width="32"
            Height="32"
            RenderOptions.BitmapScalingMode="HighQuality"
            Source="{Binding ForegroundIcon}" />
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Style="{StaticResource Hint}" Text="{l:Tr Apps_LastInFront}" />
          <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding ForegroundName}" />
          <TextBlock Style="{StaticResource Hint}" Text="{Binding ForegroundStatus}" />
        </StackPanel>
        <ui:Button
          Grid.Column="2"
          VerticalAlignment="Center"
          Command="{Binding AddForegroundCommand}"
          Content="{l:Tr Apps_AddThis}"
          Icon="{ui:SymbolIcon Add24}"
          Visibility="{Binding CanAddForeground, Converter={StaticResource BoolToVisibility}}" />
      </Grid>
    </Border>

    <Grid Margin="0,8,0,0">
      <TextBlock Style="{StaticResource SectionHeader}" Text="{l:Tr Apps_Rules}" />
      <ui:Button
        Margin="0,14,0,0"
        HorizontalAlignment="Right"
        VerticalAlignment="Bottom"
        Appearance="Primary"
        Command="{Binding OpenPickerCommand}"
        Content="{l:Tr Apps_AddApp}"
        Icon="{ui:SymbolIcon Add24}" />
    </Grid>

    <!-- Picker: running programs -->
    <Border
      Padding="16,14"
      Style="{StaticResource SettingCard}"
      Visibility="{Binding IsPicking, Converter={StaticResource BoolToVisibility}}">
      <StackPanel>
        <Grid>
          <TextBlock FontWeight="SemiBold" Text="{l:Tr Apps_PickTitle}" />
          <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
            <ui:Button
              Margin="0,0,8,0"
              Command="{Binding BrowseCommand}"
              Content="{l:Tr Apps_Browse}"
              Icon="{ui:SymbolIcon FolderOpen24}" />
            <ui:Button Command="{Binding ClosePickerCommand}" Content="{l:Tr Common_Cancel}" />
          </StackPanel>
        </Grid>
        <ui:TextBox
          Margin="0,12,0,8"
          Icon="{ui:SymbolIcon Search24}"
          PlaceholderText="{l:Tr Apps_Search}"
          Text="{Binding PickerQuery, UpdateSourceTrigger=PropertyChanged}" />
        <ItemsControl ItemsSource="{Binding RunningApps}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:RunningAppItem}">
              <Button
                Margin="0,2"
                Padding="10,8"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                Command="{Binding DataContext.AddRunningCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                CommandParameter="{Binding}"
                IsEnabled="{Binding HasRule, Converter={x:Static ctl:InverseBoolConverter.Instance}}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Image
                    Width="24"
                    Height="24"
                    Margin="0,0,12,0"
                    RenderOptions.BitmapScalingMode="HighQuality"
                    Source="{Binding Icon}" />
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Name}" />
                    <TextBlock
                      Style="{StaticResource Hint}"
                      Text="{Binding WindowTitle}"
                      TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <TextBlock
                    Grid.Column="2"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    Style="{StaticResource Hint}"
                    Text="{Binding FileName}" />
                </Grid>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <Border Style="{StaticResource SettingCard}" Visibility="{Binding HasRules, Converter={x:Static ctl:InverseBoolToVisibilityConverter.Instance}}">
      <StackPanel Margin="0,8">
        <TextBlock HorizontalAlignment="Center" Text="{l:Tr Apps_EmptyTitle}" />
        <TextBlock
          Margin="0,4,0,0"
          HorizontalAlignment="Center"
          Style="{StaticResource Hint}"
          Text="{l:Tr Apps_EmptyHint}" />
      </StackPanel>
    </Border>

    <ItemsControl ItemsSource="{Binding Rules}">
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="{x:Type vm:AppRuleItem}">
          <Border Padding="16,12" Style="{StaticResource SettingCard}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Image
                Width="32"
                Height="32"
                Margin="0,0,14,0"
                VerticalAlignment="Center"
                RenderOptions.BitmapScalingMode="HighQuality"
                Source="{Binding Icon}" />
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                  <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                  <Border
                    Margin="8,0,0,0"
                    Padding="6,1"
                    VerticalAlignment="Center"
                    Background="{DynamicResource AccentFillColorDefaultBrush}"
                    CornerRadius="4"
                    Visibility="{Binding IsActiveNow, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock
                      FontSize="11"
                      Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                      Text="{l:Tr Common_On}" />
                  </Border>
                </StackPanel>
                <TextBlock Style="{StaticResource Hint}" Text="{Binding Executable}" />
              </StackPanel>
              <ComboBox
                Grid.Column="2"
                MinWidth="190"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                ItemsSource="{Binding Profiles}"
                SelectedItem="{Binding Profile}">
                <ComboBox.ItemTemplate>
                  <DataTemplate DataType="{x:Type vm:ProfileChoice}">
                    <StackPanel Orientation="Horizontal">
                      <Border
                        Width="36"
                        Height="14"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        CornerRadius="3">
                        <Border.Background>
                          <ImageBrush ImageSource="{Binding Preview}" Stretch="UniformToFill" />
                        </Border.Background>
                      </Border>
                      <TextBlock VerticalAlignment="Center" Text="{Binding Name}" />
                    </StackPanel>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <ui:ToggleSwitch
                Grid.Column="3"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                IsChecked="{Binding Enabled}" />
              <ui:Button
                Grid.Column="4"
                Margin="8,0,0,0"
                VerticalAlignment="Center"
                Appearance="Transparent"
                Command="{Binding RemoveCommand}"
                Icon="{ui:SymbolIcon Delete24}"
                ToolTip="{l:Tr Apps_Remove}" />
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <TextBlock
      Margin="2,8,0,0"
      Style="{StaticResource Hint}"
      Text="{l:Tr Apps_OrderHint}" />
  </StackPanel>
</UserControl>
