<UserControl
  x:Class="DispHub.Views.EffectsView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ctl="clr-namespace:DispHub.Controls"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:l="clr-namespace:DispHub.Localization"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:vm="clr-namespace:DispHub.ViewModels"
  d:DataContext="{d:DesignInstance Type=vm:EffectsViewModel}"
  mc:Ignorable="d">
  <UserControl.Resources>
    <!-- A look in the row of looks: its picture and name. -->
    <Style x:Key="LookTileItem" TargetType="ListBoxItem">
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="ToolTip" Value="{Binding Hint}" />
      <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border
              x:Name="Card"
              Width="128"
              Padding="4"
              Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
              BorderThickness="1"
              CornerRadius="8">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Card" Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                <Setter TargetName="Card" Property="BorderThickness" Value="2" />
                <Setter TargetName="Card" Property="Padding" Value="3" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SettingSlider" BasedOn="{StaticResource {x:Type Slider}}" TargetType="Slider">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="IsMoveToPointEnabled" Value="True" />
      <Setter Property="Minimum" Value="0" />
      <Setter Property="Maximum" Value="1" />
      <Setter Property="LargeChange" Value="0.1" />
    </Style>

    <!-- One setting: name, slider (or list), value and an undo button. -->
    <DataTemplate x:Key="SettingRow" DataType="{x:Type vm:LookSettingViewModel}">
      <Grid Margin="0,2" IsEnabled="{Binding IsApplicable}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="150" />
          <ColumnDefinition Width="*" MinWidth="120" />
          <ColumnDefinition Width="64" />
        </Grid.ColumnDefinitions>
        <TextBlock VerticalAlignment="Center" Text="{Binding Name}" TextTrimming="CharacterEllipsis">
          <TextBlock.Style>
            <Style BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="TextBlock">
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsApplicable}" Value="False">
                  <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
        <Slider
          Grid.Column="1"
          ctl:DoubleClick.Command="{Binding ResetCommand}"
          AutomationProperties.Name="{Binding Name}"
          SmallChange="{Binding Step}"
          Style="{StaticResource SettingSlider}"
          ToolTip="{l:Tr Effects_DoubleClickReset}"
          Value="{Binding Position}"
          Visibility="{Binding IsSlider, Converter={StaticResource BoolToVisibility}}" />
        <!-- A tint's colour: a few clear colours to pick from. -->
        <ListBox
          Grid.Column="1"
          Grid.ColumnSpan="2"
          AutomationProperties.Name="{Binding Name}"
          ItemsSource="{Binding Hues}"
          SelectedItem="{Binding SelectedHue}"
          Style="{StaticResource SwatchList}"
          Visibility="{Binding IsHue, Converter={StaticResource BoolToVisibility}}" />
        <ComboBox
          Grid.Column="1"
          Grid.ColumnSpan="2"
          MinWidth="180"
          HorizontalAlignment="Left"
          AutomationProperties.Name="{Binding Name}"
          ItemsSource="{Binding Options}"
          SelectedItem="{Binding SelectedOption}"
          Visibility="{Binding IsChoice, Converter={StaticResource BoolToVisibility}}" />
        <TextBlock
          Grid.Column="2"
          HorizontalAlignment="Right"
          VerticalAlignment="Center"
          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
          Text="{Binding DisplayValue}"
          Visibility="{Binding IsSlider, Converter={StaticResource BoolToVisibility}}" />
      </Grid>
    </DataTemplate>
  </UserControl.Resources>

  <StackPanel>
    <Grid>
      <TextBlock Style="{StaticResource PageTitle}" Text="{l:Tr Effects_Title}" />
      <ui:ToggleSwitch
        HorizontalAlignment="Right"
        VerticalAlignment="Center"
        Content="{Binding Enabled, Converter={x:Static ctl:OnOffConverter.Instance}}"
        IsChecked="{Binding Enabled}" />
    </Grid>
    <TextBlock Style="{StaticResource PageSubtitle}" Text="{l:Tr Effects_Subtitle}" />

    <ui:Button
      Margin="0,0,0,12"
      Appearance="Primary"
      Command="{Binding UpgradeCommand}"
      Content="{l:Tr Effects_Upgrade}"
      Icon="{ui:SymbolIcon Star24}"
      Visibility="{Binding IsPro, Converter={x:Static ctl:InverseBoolToVisibilityConverter.Instance}}" />

    <!-- Preview: the look on a photo, before and after, with the current look beside it (or below, when narrow),
         and every look in one row underneath to flick through. -->
    <Border
      x:Name="PreviewCard"
      Padding="16"
      ctl:Tour.Stop="effects"
      SizeChanged="OnPreviewCardSizeChanged"
      Style="{StaticResource SettingCard}">
      <StackPanel>
        <Grid x:Name="PreviewGrid">
          <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="PictureColumn" Width="3*" MaxWidth="580" />
            <ColumnDefinition x:Name="InfoColumn" Width="2*" MinWidth="220" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid VerticalAlignment="Top">
            <ctl:CompareView
              After="{Binding Preview}"
              AfterLabel="{l:Tr Effects_After}"
              AutomationProperties.Name="{l:Tr Effects_PreviewName}"
              Before="{Binding Original}"
              BeforeLabel="{l:Tr Effects_Before}"
              Position="{Binding ComparePosition}" />
            <TextBlock
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Style="{StaticResource Hint}"
              Text="{l:Tr Effects_PreviewFailed}"
              Visibility="{Binding PreviewFailed, Converter={StaticResource BoolToVisibility}}" />
          </Grid>
          <DockPanel x:Name="InfoPanel" Grid.Column="1" Margin="20,0,0,0">
            <StackPanel
              Margin="-8,8,0,0"
              HorizontalAlignment="Left"
              DockPanel.Dock="Bottom"
              Orientation="Horizontal">
              <ui:Button
                Width="32"
                Height="32"
                Padding="0"
                Appearance="Transparent"
                Command="{Binding PreviousPictureCommand}"
                Icon="{ui:SymbolIcon ChevronLeft20}"
                ToolTip="{l:Tr Effects_PreviousPicture}"
                AutomationProperties.Name="{l:Tr Effects_PreviousPicture}" />
              <TextBlock
                MinWidth="100"
                VerticalAlignment="Center"
                Style="{StaticResource Hint}"
                Text="{Binding Picture.Name}"
                TextAlignment="Center" />
              <ui:Button
                Width="32"
                Height="32"
                Padding="0"
                Appearance="Transparent"
                Command="{Binding NextPictureCommand}"
                Icon="{ui:SymbolIcon ChevronRight20}"
                ToolTip="{l:Tr Effects_NextPicture}"
                AutomationProperties.Name="{l:Tr Effects_NextPicture}" />
            </StackPanel>
            <StackPanel>
              <TextBlock Style="{StaticResource Hint}" Text="{l:Tr Effects_CurrentLook}" />
              <TextBlock
                Margin="0,2,0,0"
                FontSize="22"
                FontWeight="SemiBold"
                Text="{Binding CurrentName}"
                TextWrapping="Wrap" />
              <TextBlock
                Margin="0,6,0,14"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{Binding CurrentHint}"
                TextWrapping="Wrap" />
              <!-- Always there, enabled when they can do something, so nothing jumps. -->
              <WrapPanel>
                <ui:Button
                  Margin="0,0,6,6"
                  Command="{Binding ResetCommand}"
                  Content="{l:Tr Effects_Reset}"
                  Icon="{ui:SymbolIcon ArrowUndo20}"
                  IsEnabled="{Binding IsModified}" />
                <ui:Button
                  Margin="0,0,6,6"
                  Command="{Binding CopyLinkCommand}"
                  Icon="{ui:SymbolIcon Link20}"
                  IsEnabled="{Binding HasLook}">
                  <ui:Button.Style>
                    <Style BasedOn="{StaticResource {x:Type ui:Button}}" TargetType="ui:Button">
                      <Setter Property="Content" Value="{l:Tr Effects_CopyLink}" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding LinkCopied}" Value="True">
                          <Setter Property="Content" Value="{l:Tr Effects_LinkCopied}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </ui:Button.Style>
                </ui:Button>
              </WrapPanel>
              <ui:InfoBar
                Title="{Binding StatusTitle}"
                Margin="0,6,0,0"
                IsClosable="False"
                IsOpen="{Binding ShowStatus}"
                Message="{Binding StatusText}"
                Severity="{Binding StatusSeverity}" />
            </StackPanel>
          </DockPanel>
        </Grid>

        <Separator Margin="0,16,0,12" />

        <!-- Every look in one row: categories above, arrows on both sides. -->
        <ListBox
          Margin="0,0,0,8"
          Background="Transparent"
          BorderThickness="0"
          ItemsSource="{Binding Categories}"
          SelectedItem="{Binding SelectedCategory}">
          <ListBox.Template>
            <ControlTemplate TargetType="ListBox">
              <ItemsPresenter />
            </ControlTemplate>
          </ListBox.Template>
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemContainerStyle>
            <Style BasedOn="{StaticResource Chip}" TargetType="ListBoxItem">
              <Setter Property="Margin" Value="0,0,6,6" />
            </Style>
          </ListBox.ItemContainerStyle>
        </ListBox>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <ui:Button
            x:Name="StripBack"
            Width="32"
            Height="72"
            Margin="0,0,6,22"
            Padding="0"
            Appearance="Transparent"
            Click="OnStripBack"
            Icon="{ui:SymbolIcon ChevronLeft20}"
            ToolTip="{l:Tr Effects_MoreLooksBack}"
            AutomationProperties.Name="{l:Tr Effects_MoreLooksBack}" />
          <ScrollViewer
            x:Name="Strip"
            Grid.Column="1"
            HorizontalScrollBarVisibility="Hidden"
            PanningMode="HorizontalOnly"
            ScrollChanged="OnStripScrolled"
            VerticalScrollBarVisibility="Disabled">
            <ListBox
              x:Name="LookList"
              Background="Transparent"
              BorderThickness="0"
              ItemContainerStyle="{StaticResource LookTileItem}"
              ItemsSource="{Binding Tiles}"
              SelectedItem="{Binding SelectedTile}">
              <ListBox.Template>
                <ControlTemplate TargetType="ListBox">
                  <ItemsPresenter />
                </ControlTemplate>
              </ListBox.Template>
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:LookTile}">
                  <StackPanel>
                    <Grid Height="68">
                      <Border Background="{DynamicResource ControlFillColorSecondaryBrush}" CornerRadius="5" />
                      <Border CornerRadius="5">
                        <Border.Background>
                          <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill" />
                        </Border.Background>
                      </Border>
                      <ui:Button
                        Width="24"
                        Height="24"
                        Margin="0,4,4,0"
                        Padding="0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Command="{Binding DeleteCommand}"
                        Icon="{ui:SymbolIcon Delete16}"
                        ToolTip="{l:Tr Effects_DeleteLook}"
                        AutomationProperties.Name="{l:Tr Effects_DeleteLook}"
                        Visibility="{Binding IsSaved, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                    <TextBlock
                      Margin="3,5,3,1"
                      Text="{Binding Name}"
                      TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </ScrollViewer>
          <ui:Button
            x:Name="StripForward"
            Grid.Column="2"
            Width="32"
            Height="72"
            Margin="6,0,0,22"
            Padding="0"
            Appearance="Transparent"
            Click="OnStripForward"
            Icon="{ui:SymbolIcon ChevronRight20}"
            ToolTip="{l:Tr Effects_MoreLooksForward}"
            AutomationProperties.Name="{l:Tr Effects_MoreLooksForward}" />
        </Grid>
      </StackPanel>
    </Border>

    <!-- The editor -->
    <ctl:SectionHeader Text="{l:Tr Effects_Adjust}">
      <ui:Button
        Appearance="Transparent"
        Command="{Binding ClearCommand}"
        Content="{l:Tr Effects_Clear}"
        Icon="{ui:SymbolIcon Eraser20}" />
    </ctl:SectionHeader>
    <Border Style="{StaticResource SettingCard}">
      <!-- Lined up with the effects below, whose rows start after an icon. -->
      <StackPanel Margin="28,0,32,0">
        <Grid Margin="0,2" IsEnabled="{Binding HasLook}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150" />
            <ColumnDefinition Width="*" MinWidth="120" />
            <ColumnDefinition Width="64" />
          </Grid.ColumnDefinitions>
          <TextBlock
            VerticalAlignment="Center"
            FontWeight="SemiBold"
            Text="{l:Tr Effects_Strength}" />
          <Slider
            Grid.Column="1"
            ctl:DoubleClick.Command="{Binding ResetStrengthCommand}"
            ToolTip="{l:Tr Effects_DoubleClickReset}"
            AutomationProperties.Name="{l:Tr Effects_Strength}"
            Maximum="1.5"
            SmallChange="0.05"
            Style="{StaticResource SettingSlider}"
            Value="{Binding Strength}" />
          <TextBlock
            Grid.Column="2"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
            Text="{Binding StrengthText}" />
        </Grid>
        <ItemsControl ItemTemplate="{StaticResource SettingRow}" ItemsSource="{Binding Basics}" />
      </StackPanel>
    </Border>

    <!-- The effects in the look on the left, the ones to add on the right (below, when narrow). -->
    <ctl:SectionHeader Text="{l:Tr Effects_InLook}" />
    <Grid x:Name="EditorPanes" SizeChanged="OnEditorSizeChanged">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition x:Name="LibraryColumn" Width="270" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Border
        x:Name="DropZone"
        MinHeight="96"
        AllowDrop="True"
        Background="Transparent"
        BorderBrush="Transparent"
        BorderThickness="2"
        CornerRadius="10"
        DragEnter="OnDragOverLook"
        DragLeave="OnDragLeaveLook"
        DragOver="OnDragOverLook"
        Drop="OnDropOnLook">
        <StackPanel>
          <Border
            Padding="16,24"
            Style="{StaticResource SettingCard}"
            Visibility="{Binding Parts.Count, Converter={x:Static ctl:ZeroToVisibleConverter.Instance}}">
            <TextBlock
              HorizontalAlignment="Center"
              Style="{StaticResource Hint}"
              Text="{l:Tr Effects_NoParts}"
              TextAlignment="Center"
              TextWrapping="Wrap" />
          </Border>
          <ItemsControl ItemsSource="{Binding Parts}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:LookPartViewModel}">
                <Border Padding="12,4,6,4" Style="{StaticResource SettingCard}">
                  <StackPanel>
                    <DockPanel MinHeight="36">
                      <ui:Button
                        Width="28"
                        Height="28"
                        Margin="2,0,0,0"
                        Padding="0"
                        Appearance="Transparent"
                        Command="{Binding RemoveCommand}"
                        DockPanel.Dock="Right"
                        Icon="{ui:SymbolIcon Dismiss16}"
                        ToolTip="{l:Tr Effects_RemovePart}"
                        AutomationProperties.Name="{l:Tr Effects_RemovePart}" />
                      <ui:Button
                        Width="28"
                        Height="28"
                        Padding="0"
                        Appearance="Transparent"
                        Command="{Binding ToggleDetailsCommand}"
                        DockPanel.Dock="Right"
                        ToolTip="{l:Tr Effects_Customise}"
                        AutomationProperties.Name="{l:Tr Effects_Customise}">
                        <ui:SymbolIcon FontSize="16">
                          <ui:SymbolIcon.Style>
                            <Style TargetType="ui:SymbolIcon">
                              <Setter Property="Symbol" Value="ChevronDown16" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                  <Setter Property="Symbol" Value="ChevronUp16" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </ui:SymbolIcon.Style>
                        </ui:SymbolIcon>
                      </ui:Button>
                      <TextBlock
                        Margin="8,0"
                        VerticalAlignment="Center"
                        DockPanel.Dock="Right"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{Binding Main.DisplayValue}" />
                      <ui:SymbolIcon
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        FontSize="18"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Symbol="{Binding Icon}" />
                      <TextBlock
                        VerticalAlignment="Center"
                        Text="{Binding Name}"
                        TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <StackPanel Margin="28,4,30,6" Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">
                      <ContentPresenter Content="{Binding Main}" ContentTemplate="{StaticResource SettingRow}" />
                      <ItemsControl ItemTemplate="{StaticResource SettingRow}" ItemsSource="{Binding Details}" />
                    </StackPanel>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- Effects to add: drag one onto the look, or select its + button. -->
      <Border
        x:Name="LibraryBox"
        Grid.Column="1"
        MaxHeight="440"
        Margin="12,0,0,6"
        Padding="0"
        VerticalAlignment="Top"
        Style="{StaticResource SettingCard}">
        <DockPanel>
          <TextBlock
            Margin="14,10,14,2"
            DockPanel.Dock="Top"
            FontWeight="SemiBold"
            Text="{l:Tr Effects_AddPart}" />
          <TextBlock
            Margin="14,0,14,6"
            DockPanel.Dock="Top"
            Style="{StaticResource Hint}"
            Text="{l:Tr Effects_AddPartHint}"
            TextWrapping="Wrap" />
          <ctl:SmoothScrollViewer Padding="6,0,6,6">
            <ItemsControl Margin="0,0,12,0" ItemsSource="{Binding Library}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:LibraryGroup}">
                  <StackPanel>
                    <TextBlock
                      Margin="8,8,8,2"
                      Style="{StaticResource Hint}"
                      Text="{Binding Name}" />
                    <ItemsControl ItemsSource="{Binding Effects}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:LibraryEffect}">
                          <!-- Click to add, or drag onto the look. Added ones stay in place, dimmed, so nothing moves. -->
                          <ui:Button
                            Margin="0,1"
                            Padding="8,6"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Appearance="Transparent"
                            BorderThickness="0"
                            Command="{Binding AddCommand}"
                            Cursor="Hand"
                            IsEnabled="{Binding CanAdd}"
                            MouseMove="OnLibraryItemMouseMove"
                            PreviewMouseLeftButtonDown="OnLibraryItemPressed"
                            Tag="{Binding Key}"
                            ToolTip="{Binding Hint}"
                            ToolTipService.ShowOnDisabled="True"
                            AutomationProperties.Name="{Binding Name}">
                            <DockPanel>
                              <ui:SymbolIcon
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                DockPanel.Dock="Right"
                                FontSize="16"
                                Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                Symbol="Checkmark16"
                                Visibility="{Binding IsAdded, Converter={StaticResource BoolToVisibility}}" />
                              <ui:SymbolIcon
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                FontSize="16"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Symbol="{Binding Icon}" />
                              <TextBlock
                                VerticalAlignment="Center"
                                Text="{Binding Name}"
                                TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                          </ui:Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ctl:SmoothScrollViewer>
        </DockPanel>
      </Border>
    </Grid>

    <!-- Save -->
    <ctl:SettingsCard
      Margin="0,8,0,4"
      Description="{l:Tr Effects_SaveHint}"
      Header="{l:Tr Effects_SaveTitle}"
      Icon="Save24"
      WrapWidth="620">
      <StackPanel Orientation="Horizontal">
        <ui:TextBox
          Width="180"
          Margin="0,0,8,0"
          MaxLength="40"
          PlaceholderText="{l:Tr Effects_SaveName}"
          Text="{Binding NewLookName, UpdateSourceTrigger=PropertyChanged}" />
        <ui:Button Command="{Binding SaveLookCommand}" Content="{l:Tr Effects_Save}" />
      </StackPanel>
    </ctl:SettingsCard>

    <!-- Options -->
    <ctl:SectionHeader Text="{l:Tr Effects_Options}" />
    <ctl:SettingsCard
      Description="{l:Tr Effects_HideFullScreenHint}"
      Header="{l:Tr Effects_HideFullScreen}"
      Icon="Games24">
      <ui:ToggleSwitch IsChecked="{Binding HideOverFullScreen}" />
    </ctl:SettingsCard>
    <ctl:SettingsCard
      Description="{l:Tr Effects_MainDisplayOnlyHint}"
      Header="{l:Tr Effects_MainDisplayOnly}"
      Icon="Desktop24">
      <ui:ToggleSwitch IsChecked="{Binding MainDisplayOnly}" />
    </ctl:SettingsCard>
    <ctl:SettingsCard
      Description="{l:Tr Effects_FrameRateHint}"
      Header="{l:Tr Effects_FrameRate}"
      Icon="TopSpeed24">
      <ComboBox
        MinWidth="170"
        ItemsSource="{Binding FrameRates}"
        SelectedItem="{Binding FrameRate}" />
    </ctl:SettingsCard>
    <TextBlock
      Margin="2,8,0,0"
      Style="{StaticResource Hint}"
      Text="{l:Tr Effects_Notes}"
      TextWrapping="Wrap" />
  </StackPanel>
</UserControl>
