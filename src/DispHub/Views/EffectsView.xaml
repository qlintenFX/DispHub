<UserControl
  x:Class="DispHub.Views.EffectsView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ctl="clr-namespace:DispHub.Controls"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:l="clr-namespace:DispHub.Localization"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:vm="clr-namespace:DispHub.ViewModels"
  d:DataContext="{d:DesignInstance Type=vm:EffectsViewModel}"
  mc:Ignorable="d">
  <UserControl.Resources>
    <!-- A look in the gallery: its picture and name. -->
    <Style x:Key="LookTileItem" TargetType="ListBoxItem">
      <Setter Property="Margin" Value="0,0,8,8" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="ToolTip" Value="{Binding Hint}" />
      <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border
              x:Name="Card"
              Width="160"
              Padding="5"
              Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
              BorderThickness="1"
              CornerRadius="8">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Card" Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                <Setter TargetName="Card" Property="BorderThickness" Value="2" />
                <Setter TargetName="Card" Property="Padding" Value="4" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <LinearGradientBrush x:Key="HueBrush" StartPoint="0,0" EndPoint="1,0">
      <GradientStop Offset="0" Color="#E04848" />
      <GradientStop Offset="0.17" Color="#E0E048" />
      <GradientStop Offset="0.33" Color="#48E048" />
      <GradientStop Offset="0.5" Color="#48E0E0" />
      <GradientStop Offset="0.67" Color="#4848E0" />
      <GradientStop Offset="0.83" Color="#E048E0" />
      <GradientStop Offset="1" Color="#E04848" />
    </LinearGradientBrush>

    <Style x:Key="SettingSlider" BasedOn="{StaticResource {x:Type Slider}}" TargetType="Slider">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="IsMoveToPointEnabled" Value="True" />
      <Setter Property="Minimum" Value="0" />
      <Setter Property="Maximum" Value="1" />
      <Setter Property="LargeChange" Value="0.1" />
    </Style>

    <!-- One setting: name, slider (or list), value and an undo button. -->
    <DataTemplate x:Key="SettingRow" DataType="{x:Type vm:LookSettingViewModel}">
      <Grid Margin="0,2" IsEnabled="{Binding IsApplicable}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="150" />
          <ColumnDefinition Width="*" MinWidth="120" />
          <ColumnDefinition Width="64" />
          <ColumnDefinition Width="32" />
        </Grid.ColumnDefinitions>
        <TextBlock VerticalAlignment="Center" Text="{Binding Name}" TextTrimming="CharacterEllipsis">
          <TextBlock.Style>
            <Style BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="TextBlock">
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsApplicable}" Value="False">
                  <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
        <Grid Grid.Column="1" Visibility="{Binding IsChoice, Converter={x:Static ctl:InverseBoolToVisibilityConverter.Instance}}">
          <Slider
            AutomationProperties.Name="{Binding Name}"
            SmallChange="{Binding Step}"
            Style="{StaticResource SettingSlider}"
            Value="{Binding Position}" />
          <!-- Colour sliders show the hues under the track. -->
          <Border
            Height="3"
            Margin="10,0,10,2"
            VerticalAlignment="Bottom"
            Background="{StaticResource HueBrush}"
            CornerRadius="1.5"
            IsHitTestVisible="False"
            Visibility="{Binding IsHue, Converter={StaticResource BoolToVisibility}}" />
        </Grid>
        <ComboBox
          Grid.Column="1"
          Grid.ColumnSpan="2"
          MinWidth="180"
          HorizontalAlignment="Left"
          AutomationProperties.Name="{Binding Name}"
          ItemsSource="{Binding Options}"
          SelectedItem="{Binding SelectedOption}"
          Visibility="{Binding IsChoice, Converter={StaticResource BoolToVisibility}}" />
        <TextBlock
          Grid.Column="2"
          HorizontalAlignment="Right"
          VerticalAlignment="Center"
          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
          Text="{Binding DisplayValue}"
          Visibility="{Binding IsChoice, Converter={x:Static ctl:InverseBoolToVisibilityConverter.Instance}}" />
        <ui:Button
          Grid.Column="3"
          Width="28"
          Height="28"
          Padding="0"
          HorizontalAlignment="Right"
          Appearance="Transparent"
          Command="{Binding ResetCommand}"
          Icon="{ui:SymbolIcon ArrowUndo16}"
          ToolTip="{l:Tr Effects_ResetSetting}"
          AutomationProperties.Name="{l:Tr Effects_ResetSetting}"
          Visibility="{Binding ShowReset, Converter={StaticResource BoolToVisibility}}" />
      </Grid>
    </DataTemplate>
  </UserControl.Resources>

  <StackPanel>
    <Grid>
      <TextBlock Style="{StaticResource PageTitle}" Text="{l:Tr Effects_Title}" />
      <ui:ToggleSwitch
        HorizontalAlignment="Right"
        VerticalAlignment="Center"
        Content="{Binding Enabled, Converter={x:Static ctl:OnOffConverter.Instance}}"
        IsChecked="{Binding Enabled}" />
    </Grid>
    <TextBlock Style="{StaticResource PageSubtitle}" Text="{l:Tr Effects_Subtitle}" />

    <ui:InfoBar
      Title="{Binding StatusTitle}"
      Margin="0,0,0,8"
      IsClosable="False"
      IsOpen="{Binding ShowStatus}"
      Message="{Binding StatusText}"
      Severity="{Binding StatusSeverity}" />
    <ui:Button
      Margin="0,0,0,12"
      Appearance="Primary"
      Command="{Binding UpgradeCommand}"
      Content="{l:Tr Effects_Upgrade}"
      Icon="{ui:SymbolIcon Star24}"
      Visibility="{Binding IsPro, Converter={x:Static ctl:InverseBoolToVisibilityConverter.Instance}}" />

    <!-- Preview: the look on a photo, before and after, with the current look beside it (or below, when narrow). -->
    <Border
      x:Name="PreviewCard"
      Padding="16"
      SizeChanged="OnPreviewCardSizeChanged"
      Style="{StaticResource SettingCard}">
      <Grid x:Name="PreviewGrid">
        <Grid.ColumnDefinitions>
          <ColumnDefinition x:Name="PictureColumn" Width="3*" MaxWidth="580" />
          <ColumnDefinition x:Name="InfoColumn" Width="2*" MinWidth="220" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid VerticalAlignment="Top">
          <ctl:CompareView
            After="{Binding Preview}"
            AfterLabel="{l:Tr Effects_After}"
            AutomationProperties.Name="{l:Tr Effects_PreviewName}"
            Before="{Binding Original}"
            BeforeLabel="{l:Tr Effects_Before}"
            Position="{Binding ComparePosition}" />
          <TextBlock
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Style="{StaticResource Hint}"
            Text="{l:Tr Effects_PreviewFailed}"
            Visibility="{Binding PreviewFailed, Converter={StaticResource BoolToVisibility}}" />
        </Grid>
        <DockPanel x:Name="InfoPanel" Grid.Column="1" Margin="20,0,0,0">
          <StackPanel
            Margin="-8,8,0,0"
            HorizontalAlignment="Left"
            DockPanel.Dock="Bottom"
            Orientation="Horizontal">
            <ui:Button
              Width="32"
              Height="32"
              Padding="0"
              Appearance="Transparent"
              Command="{Binding PreviousPictureCommand}"
              Icon="{ui:SymbolIcon ChevronLeft20}"
              ToolTip="{l:Tr Effects_PreviousPicture}"
              AutomationProperties.Name="{l:Tr Effects_PreviousPicture}" />
            <TextBlock
              MinWidth="100"
              VerticalAlignment="Center"
              Style="{StaticResource Hint}"
              Text="{Binding Picture.Name}"
              TextAlignment="Center" />
            <ui:Button
              Width="32"
              Height="32"
              Padding="0"
              Appearance="Transparent"
              Command="{Binding NextPictureCommand}"
              Icon="{ui:SymbolIcon ChevronRight20}"
              ToolTip="{l:Tr Effects_NextPicture}"
              AutomationProperties.Name="{l:Tr Effects_NextPicture}" />
          </StackPanel>
          <StackPanel>
            <TextBlock Style="{StaticResource Hint}" Text="{l:Tr Effects_CurrentLook}" />
            <WrapPanel Margin="0,2,0,0">
              <TextBlock
                Margin="0,0,8,0"
                FontSize="22"
                FontWeight="SemiBold"
                Text="{Binding CurrentName}"
                TextWrapping="Wrap" />
              <Border
                Margin="0,4,0,0"
                Padding="8,1"
                VerticalAlignment="Center"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                CornerRadius="9"
                Visibility="{Binding IsModified, Converter={StaticResource BoolToVisibility}}">
                <TextBlock FontSize="11" Text="{l:Tr Effects_Modified}" />
              </Border>
            </WrapPanel>
            <TextBlock
              Margin="0,6,0,14"
              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
              Text="{Binding CurrentHint}"
              TextWrapping="Wrap" />
            <WrapPanel>
              <ui:Button
                Margin="0,0,6,6"
                Command="{Binding ResetCommand}"
                Content="{l:Tr Effects_Reset}"
                Icon="{ui:SymbolIcon ArrowUndo20}"
                Visibility="{Binding IsModified, Converter={StaticResource BoolToVisibility}}" />
              <ui:Button
                Margin="0,0,6,6"
                Command="{Binding CopyLinkCommand}"
                Icon="{ui:SymbolIcon Link20}"
                Visibility="{Binding HasLook, Converter={StaticResource BoolToVisibility}}">
                <ui:Button.Style>
                  <Style BasedOn="{StaticResource {x:Type ui:Button}}" TargetType="ui:Button">
                    <Setter Property="Content" Value="{l:Tr Effects_CopyLink}" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding LinkCopied}" Value="True">
                        <Setter Property="Content" Value="{l:Tr Effects_LinkCopied}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </ui:Button.Style>
              </ui:Button>
            </WrapPanel>
          </StackPanel>
        </DockPanel>
      </Grid>
    </Border>

    <!-- The gallery -->
    <ctl:SectionHeader Text="{l:Tr Effects_Looks}" />
    <ListBox
      Margin="0,0,0,8"
      Background="Transparent"
      BorderThickness="0"
      ItemsSource="{Binding Categories}"
      SelectedItem="{Binding SelectedCategory}">
      <ListBox.Template>
        <ControlTemplate TargetType="ListBox">
          <ItemsPresenter />
        </ControlTemplate>
      </ListBox.Template>
      <ListBox.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel />
        </ItemsPanelTemplate>
      </ListBox.ItemsPanel>
      <ListBox.ItemContainerStyle>
        <Style BasedOn="{StaticResource Chip}" TargetType="ListBoxItem">
          <Setter Property="Margin" Value="0,0,6,6" />
        </Style>
      </ListBox.ItemContainerStyle>
    </ListBox>
    <ListBox
      Background="Transparent"
      BorderThickness="0"
      ItemContainerStyle="{StaticResource LookTileItem}"
      ItemsSource="{Binding Tiles}"
      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
      SelectedItem="{Binding SelectedTile}">
      <ListBox.Template>
        <ControlTemplate TargetType="ListBox">
          <ItemsPresenter />
        </ControlTemplate>
      </ListBox.Template>
      <ListBox.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel />
        </ItemsPanelTemplate>
      </ListBox.ItemsPanel>
      <ListBox.ItemTemplate>
        <DataTemplate DataType="{x:Type vm:LookTile}">
          <StackPanel>
            <Grid Height="94">
              <Border Background="{DynamicResource ControlFillColorSecondaryBrush}" CornerRadius="5" />
              <Border CornerRadius="5">
                <Border.Background>
                  <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill" />
                </Border.Background>
              </Border>
            </Grid>
            <Grid Margin="4,6,2,2">
              <TextBlock
                Margin="0,0,24,0"
                VerticalAlignment="Center"
                Text="{Binding Name}"
                TextTrimming="CharacterEllipsis" />
              <ui:Button
                Width="24"
                Height="24"
                Padding="0"
                HorizontalAlignment="Right"
                Appearance="Transparent"
                Command="{Binding DeleteCommand}"
                Icon="{ui:SymbolIcon Delete16}"
                ToolTip="{l:Tr Effects_DeleteLook}"
                AutomationProperties.Name="{l:Tr Effects_DeleteLook}"
                Visibility="{Binding IsSaved, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <!-- The editor -->
    <ctl:SectionHeader Text="{l:Tr Effects_Adjust}">
      <ui:Button
        Appearance="Transparent"
        Command="{Binding ClearCommand}"
        Content="{l:Tr Effects_Clear}"
        Icon="{ui:SymbolIcon Eraser20}" />
    </ctl:SectionHeader>
    <Border Style="{StaticResource SettingCard}">
      <!-- Lined up with the effects below, whose rows start after an icon. -->
      <StackPanel Margin="28,0,64,0">
        <Grid Margin="0,2" Visibility="{Binding HasLook, Converter={StaticResource BoolToVisibility}}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150" />
            <ColumnDefinition Width="*" MinWidth="120" />
            <ColumnDefinition Width="64" />
            <ColumnDefinition Width="32" />
          </Grid.ColumnDefinitions>
          <TextBlock
            VerticalAlignment="Center"
            FontWeight="SemiBold"
            Text="{l:Tr Effects_Strength}" />
          <Slider
            Grid.Column="1"
            AutomationProperties.Name="{l:Tr Effects_Strength}"
            Maximum="1.5"
            SmallChange="0.05"
            Style="{StaticResource SettingSlider}"
            Value="{Binding Strength}" />
          <TextBlock
            Grid.Column="2"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
            Text="{Binding StrengthText}" />
        </Grid>
        <ItemsControl ItemTemplate="{StaticResource SettingRow}" ItemsSource="{Binding Basics}" />
      </StackPanel>
    </Border>

    <ctl:SectionHeader Text="{l:Tr Effects_InLook}">
      <ui:Button
        x:Name="AddPartButton"
        Click="OnAddPartClick"
        Content="{l:Tr Effects_AddPart}"
        Icon="{ui:SymbolIcon Add20}" />
    </ctl:SectionHeader>
    <Border Style="{StaticResource SettingCard}" Visibility="{Binding Parts.Count, Converter={x:Static ctl:ZeroToVisibleConverter.Instance}}">
      <TextBlock
        Margin="0,6"
        HorizontalAlignment="Center"
        Style="{StaticResource Hint}"
        Text="{l:Tr Effects_NoParts}" />
    </Border>
    <ItemsControl ItemsSource="{Binding Parts}">
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="{x:Type vm:LookPartViewModel}">
          <Border Style="{StaticResource SettingCard}">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:SymbolIcon
                  Margin="0,0,10,0"
                  VerticalAlignment="Center"
                  FontSize="18"
                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                  Symbol="{Binding Icon}" />
                <ContentPresenter
                  Grid.Column="1"
                  Content="{Binding Main}"
                  ContentTemplate="{StaticResource SettingRow}" />
                <ui:Button
                  Grid.Column="2"
                  Width="28"
                  Height="28"
                  Padding="0"
                  Appearance="Transparent"
                  Command="{Binding ToggleDetailsCommand}"
                  ToolTip="{l:Tr Effects_MoreSettings}"
                  AutomationProperties.Name="{l:Tr Effects_MoreSettings}">
                  <ui:Button.Style>
                    <Style BasedOn="{StaticResource {x:Type ui:Button}}" TargetType="ui:Button">
                      <Style.Triggers>
                        <!-- Hidden, not collapsed: every row keeps the same columns. -->
                        <DataTrigger Binding="{Binding HasDetails}" Value="False">
                          <Setter Property="Visibility" Value="Hidden" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </ui:Button.Style>
                  <ui:SymbolIcon FontSize="16">
                    <ui:SymbolIcon.Style>
                      <Style TargetType="ui:SymbolIcon">
                        <Setter Property="Symbol" Value="ChevronDown16" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                            <Setter Property="Symbol" Value="ChevronUp16" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </ui:SymbolIcon.Style>
                  </ui:SymbolIcon>
                </ui:Button>
                <ui:Button
                  Grid.Column="3"
                  Width="28"
                  Height="28"
                  Margin="2,0,0,0"
                  Padding="0"
                  Appearance="Transparent"
                  Command="{Binding RemoveCommand}"
                  Icon="{ui:SymbolIcon Dismiss16}"
                  ToolTip="{l:Tr Effects_RemovePart}"
                  AutomationProperties.Name="{l:Tr Effects_RemovePart}" />
              </Grid>
              <ItemsControl
                Margin="28,6,64,0"
                ItemTemplate="{StaticResource SettingRow}"
                ItemsSource="{Binding Details}"
                Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- Save -->
    <ctl:SettingsCard
      Margin="0,8,0,4"
      Description="{l:Tr Effects_SaveHint}"
      Header="{l:Tr Effects_SaveTitle}"
      Icon="Save24"
      WrapWidth="620">
      <StackPanel Orientation="Horizontal">
        <ui:TextBox
          Width="180"
          Margin="0,0,8,0"
          MaxLength="40"
          PlaceholderText="{l:Tr Effects_SaveName}"
          Text="{Binding NewLookName, UpdateSourceTrigger=PropertyChanged}" />
        <ui:Button Command="{Binding SaveLookCommand}" Content="{l:Tr Effects_Save}" />
      </StackPanel>
    </ctl:SettingsCard>

    <!-- Options -->
    <ctl:SectionHeader Text="{l:Tr Effects_Options}" />
    <ctl:SettingsCard
      Description="{l:Tr Effects_HideFullScreenHint}"
      Header="{l:Tr Effects_HideFullScreen}"
      Icon="FullScreenMaximize24">
      <ui:ToggleSwitch IsChecked="{Binding HideOverFullScreen}" />
    </ctl:SettingsCard>
    <ctl:SettingsCard
      Description="{l:Tr Effects_HideCaptureHint}"
      Header="{l:Tr Effects_HideCapture}"
      Icon="Screenshot24">
      <ui:ToggleSwitch IsChecked="{Binding HideFromCapture}" />
    </ctl:SettingsCard>
    <ctl:SettingsCard
      Description="{l:Tr Effects_MainDisplayOnlyHint}"
      Header="{l:Tr Effects_MainDisplayOnly}"
      Icon="Desktop24">
      <ui:ToggleSwitch IsChecked="{Binding MainDisplayOnly}" />
    </ctl:SettingsCard>
    <ctl:SettingsCard
      Description="{l:Tr Effects_FrameRateHint}"
      Header="{l:Tr Effects_FrameRate}"
      Icon="TopSpeed24">
      <ComboBox
        MinWidth="170"
        ItemsSource="{Binding FrameRates}"
        SelectedItem="{Binding FrameRate}" />
    </ctl:SettingsCard>
    <TextBlock
      Margin="2,8,0,0"
      Style="{StaticResource Hint}"
      Text="{l:Tr Effects_Notes}"
      TextWrapping="Wrap" />
  </StackPanel>
</UserControl>
