<UserControl
  x:Class="DispHub.Views.PresetsView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ctl="clr-namespace:DispHub.Controls"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:l="clr-namespace:DispHub.Localization"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:vm="clr-namespace:DispHub.ViewModels"
  d:DataContext="{d:DesignInstance Type=vm:PresetsViewModel}"
  mc:Ignorable="d">
  <StackPanel>
    <TextBlock Style="{StaticResource PageTitle}" Text="{l:Tr Presets_Title}" />
    <TextBlock Style="{StaticResource PageSubtitle}" Text="{l:Tr Presets_Subtitle}" />

    <Border Style="{StaticResource SettingCard}">
      <StackPanel>
        <TextBlock Text="{l:Tr Presets_ImportTitle}" />
        <TextBlock Style="{StaticResource Hint}" Text="{l:Tr Presets_ImportHint}" />
        <Grid Margin="0,10,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <ui:TextBox PlaceholderText="disphub://preset?name=…" Text="{Binding ImportText, UpdateSourceTrigger=PropertyChanged}">
            <ui:TextBox.InputBindings>
              <KeyBinding Key="Enter" Command="{Binding ImportCommand}" />
            </ui:TextBox.InputBindings>
          </ui:TextBox>
          <ui:Button
            Grid.Column="1"
            Margin="8,0,0,0"
            Appearance="Primary"
            Command="{Binding ImportCommand}"
            Content="{l:Tr Common_Add}" />
        </Grid>
      </StackPanel>
    </Border>
    <TextBlock
      Margin="2,8,0,0"
      Style="{StaticResource Hint}"
      Text="{Binding Message}"
      Visibility="{Binding Message, Converter={x:Static ctl:NullToCollapsedConverter.Instance}}" />

    <Grid Margin="0,8,0,0">
      <TextBlock Style="{StaticResource SectionHeader}" Text="{l:Tr Presets_Gallery}" />
      <ui:HyperlinkButton
        Margin="0,16,0,0"
        HorizontalAlignment="Right"
        VerticalAlignment="Center"
        Command="{Binding ContributeCommand}"
        Content="{l:Tr Presets_Submit}" />
    </Grid>
    <ui:ProgressRing
      Margin="0,24"
      HorizontalAlignment="Left"
      IsIndeterminate="True"
      Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
    <ItemsControl ItemsSource="{Binding Presets}">
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="{x:Type vm:PresetItemViewModel}">
          <Border Style="{StaticResource SettingCard}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Border
                Height="62"
                Margin="0,0,18,0"
                VerticalAlignment="Center"
                CornerRadius="5">
                <Border.Background>
                  <ImageBrush ImageSource="{Binding Preview}" Stretch="UniformToFill" />
                </Border.Background>
              </Border>
              <StackPanel Grid.Column="1">
                <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                <TextBlock Style="{StaticResource Hint}" Text="{Binding Description}" />
                <TextBlock
                  Margin="0,4,0,0"
                  FontSize="11"
                  Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                  Text="{Binding Tags}" />
              </StackPanel>
              <StackPanel
                Grid.Column="2"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <ui:Button
                  Margin="0,0,8,0"
                  Command="{Binding CopyLinkCommand}"
                  Icon="{ui:SymbolIcon Link24}"
                  ToolTip="{l:Tr Presets_CopyLink}" />
                <ui:Button Command="{Binding AddCommand}" Content="{l:Tr Common_Add}" />
              </StackPanel>
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</UserControl>
