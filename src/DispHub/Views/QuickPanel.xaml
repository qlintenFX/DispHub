<ui:FluentWindow
  x:Class="DispHub.Views.QuickPanel"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ctl="clr-namespace:DispHub.Controls"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:l="clr-namespace:DispHub.Localization"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:vm="clr-namespace:DispHub.ViewModels"
  Title="DispHub"
  Width="372"
  d:DataContext="{d:DesignInstance Type=vm:QuickPanelViewModel}"
  ExtendsContentIntoTitleBar="True"
  ResizeMode="NoResize"
  ShowActivated="True"
  ShowInTaskbar="False"
  SizeToContent="Height"
  Topmost="True"
  WindowBackdropType="Acrylic"
  WindowCornerPreference="Round"
  mc:Ignorable="d">
  <Grid x:Name="Root" Margin="16,14,16,14">
    <Grid.RenderTransform>
      <TranslateTransform x:Name="Slide" />
    </Grid.RenderTransform>
    <StackPanel>
      <!-- Header -->
      <Grid Margin="0,0,0,12">
        <StackPanel Orientation="Horizontal">
          <Image
            Width="28"
            Height="28"
            Margin="0,0,10,0"
            RenderOptions.BitmapScalingMode="HighQuality"
            Source="pack://application:,,,/Assets/DispHub-64.png" />
          <StackPanel VerticalAlignment="Center">
            <TextBlock FontWeight="SemiBold" Text="DispHub" />
            <TextBlock
              MaxWidth="220"
              Style="{StaticResource Hint}"
              Text="{Binding Status}"
              TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </StackPanel>
        <ui:ToggleSwitch
          HorizontalAlignment="Right"
          VerticalAlignment="Center"
          IsChecked="{Binding IsActive}"
          ToolTip="{l:Tr Profiles_PauseTooltip}" />
      </Grid>

      <!-- Profiles -->
      <ItemsControl ItemsSource="{Binding Profiles}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Columns="2" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type vm:QuickProfile}">
            <Button
              Margin="0,0,6,6"
              Padding="0"
              HorizontalAlignment="Stretch"
              HorizontalContentAlignment="Stretch"
              Command="{Binding ActivateCommand}"
              Cursor="Hand">
              <Button.Template>
                <ControlTemplate TargetType="Button">
                  <Border
                    x:Name="Card"
                    Padding="8"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                    <ContentPresenter />
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Card" Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}" />
                    </Trigger>
                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                      <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                      <Setter TargetName="Card" Property="BorderThickness" Value="2" />
                    </DataTrigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Button.Template>
              <StackPanel>
                <Border Height="16" CornerRadius="3">
                  <Border.Background>
                    <ImageBrush ImageSource="{Binding Preview}" RenderOptions.BitmapScalingMode="HighQuality" Stretch="UniformToFill" />
                  </Border.Background>
                </Border>
                <TextBlock
                  Margin="0,6,0,0"
                  FontWeight="SemiBold"
                  Text="{Binding Name}"
                  TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- Quick adjust -->
      <TextBlock
        Margin="2,8,0,6"
        Style="{StaticResource Hint}"
        Text="{Binding AdjustingText}" />
      <Grid IsEnabled="{Binding CanAdjust}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="58" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ui:SymbolIcon
          Margin="0,0,8,0"
          VerticalAlignment="Center"
          FontSize="18"
          Symbol="BrightnessHigh24" />
        <TextBlock
          Grid.Column="1"
          MinWidth="78"
          Margin="0,0,8,0"
          VerticalAlignment="Center"
          Text="{l:Tr Quick_Brightness}" />
        <Slider
          Grid.Column="2"
          VerticalAlignment="Center"
          AutomationProperties.Name="{l:Tr Quick_Brightness}"
          IsMoveToPointEnabled="True"
          IsSnapToTickEnabled="True"
          Maximum="50"
          Minimum="-50"
          TickFrequency="1"
          Value="{Binding Brightness}" />
        <TextBlock
          Grid.Column="3"
          HorizontalAlignment="Right"
          VerticalAlignment="Center"
          Text="{Binding Brightness, StringFormat={}{0:+0;-0;0}}" />
        <ui:SymbolIcon
          Grid.Row="1"
          Margin="0,10,8,0"
          VerticalAlignment="Center"
          FontSize="18"
          Symbol="Temperature24" />
        <TextBlock
          Grid.Row="1"
          Grid.Column="1"
          Margin="0,10,8,0"
          VerticalAlignment="Center"
          Text="{l:Tr Quick_Warmth}" />
        <Slider
          Grid.Row="1"
          Grid.Column="2"
          Margin="0,10,0,0"
          VerticalAlignment="Center"
          AutomationProperties.Name="{l:Tr Quick_Warmth}"
          IsDirectionReversed="True"
          IsMoveToPointEnabled="True"
          IsSnapToTickEnabled="True"
          Maximum="6500"
          Minimum="2700"
          TickFrequency="100"
          Value="{Binding Warmth}" />
        <TextBlock
          Grid.Row="1"
          Grid.Column="3"
          Margin="0,10,0,0"
          HorizontalAlignment="Right"
          VerticalAlignment="Center"
          Text="{Binding Warmth, StringFormat={}{0:0} K}" />
      </Grid>

      <!-- Screen effect -->
      <Grid Margin="0,14,0,0" Visibility="{Binding ShowEffects, Converter={StaticResource BoolToVisibility}}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <ui:SymbolIcon
          Margin="0,0,8,0"
          VerticalAlignment="Center"
          FontSize="18"
          Symbol="Sparkle24" />
        <TextBlock
          Grid.Column="1"
          MinWidth="78"
          Margin="0,0,8,0"
          VerticalAlignment="Center"
          Text="{l:Tr Quick_Effect}" />
        <ComboBox
          Grid.Column="2"
          AutomationProperties.Name="{l:Tr Quick_Effect}"
          ItemsSource="{Binding Looks}"
          MaxDropDownHeight="320"
          SelectedItem="{Binding Look}" />
      </Grid>

      <!-- Footer -->
      <Grid Margin="0,12,0,0">
        <ui:Button
          Appearance="Primary"
          Command="{Binding OpenCommand}"
          Content="{l:Tr Quick_Open}"
          Icon="{ui:SymbolIcon Open24}" />
        <ui:Button
          HorizontalAlignment="Right"
          Appearance="Transparent"
          Command="{Binding QuitCommand}"
          Icon="{ui:SymbolIcon Power24}"
          ToolTip="{l:Tr Tray_Exit}"
          AutomationProperties.Name="{l:Tr Tray_Exit}" />
      </Grid>
    </StackPanel>
  </Grid>
</ui:FluentWindow>
