<UserControl
  x:Class="DispHub.Views.ProfilesView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ctl="clr-namespace:DispHub.Controls"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:l="clr-namespace:DispHub.Localization"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:vm="clr-namespace:DispHub.ViewModels"
  d:DataContext="{d:DesignInstance Type=vm:ProfilesViewModel}"
  mc:Ignorable="d">
  <UserControl.Resources>
    <Style x:Key="SliderRow" TargetType="Grid">
      <Setter Property="Margin" Value="0,6" />
    </Style>
  </UserControl.Resources>

  <StackPanel>
    <Grid>
      <TextBlock Style="{StaticResource PageTitle}" Text="{l:Tr Profiles_Title}" />
      <ui:ToggleSwitch
        HorizontalAlignment="Right"
        VerticalAlignment="Center"
        Content="{Binding IsActive, Converter={x:Static ctl:OnOffConverter.Instance}}"
        IsChecked="{Binding IsActive}"
        ToolTip="{l:Tr Profiles_PauseTooltip}" />
    </Grid>
    <TextBlock Style="{StaticResource PageSubtitle}" Text="{Binding StatusText}" />

    <ItemsControl Margin="0,0,0,12" ItemsSource="{Binding Warnings}">
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="{x:Type vm:WarningViewModel}">
          <ui:InfoBar
            Title="{Binding Title}"
            Margin="0,0,0,6"
            IsClosable="False"
            IsOpen="True"
            Message="{Binding Message}"
            Severity="{Binding Severity}">
            <ui:Button
              Margin="0,0,0,4"
              Command="{Binding Action}"
              Content="{Binding ActionText}"
              Visibility="{Binding HasAction, Converter={StaticResource BoolToVisibility}}" />
          </ui:InfoBar>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <ListBox
      ctl:Tour.Stop="profiles"
      Background="Transparent"
      BorderThickness="0"
      ItemsSource="{Binding Tiles}"
      KeyUp="OnProfileKeyUp"
      PreviewMouseLeftButtonUp="OnProfileClicked"
      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
      ScrollViewer.VerticalScrollBarVisibility="Disabled"
      SelectedItem="{Binding SelectedProfile}">
      <ListBox.ItemContainerStyleSelector>
        <ctl:TileStyleSelector AddStyle="{StaticResource AddTile}" TileStyle="{StaticResource ProfileTile}" />
      </ListBox.ItemContainerStyleSelector>
      <ListBox.Template>
        <ControlTemplate TargetType="ListBox">
          <ItemsPresenter />
        </ControlTemplate>
      </ListBox.Template>
      <ListBox.ItemsPanel>
        <ItemsPanelTemplate>
          <ctl:TileGrid FillLastRow="True" MaxColumns="4" MinTileWidth="180" />
        </ItemsPanelTemplate>
      </ListBox.ItemsPanel>
      <ListBox.Resources>
        <DataTemplate DataType="{x:Type vm:ProfileItemViewModel}">
          <StackPanel>
            <StackPanel.Style>
              <Style TargetType="StackPanel">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsLocked}" Value="True">
                    <Setter Property="Opacity" Value="0.6" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </StackPanel.Style>
            <Border Height="24" Margin="0,0,0,10" CornerRadius="4">
              <Border.Background>
                <ImageBrush ImageSource="{Binding Preview}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
              </Border.Background>
            </Border>
            <Grid>
              <TextBlock
                FontSize="14"
                FontWeight="SemiBold"
                Text="{Binding Name}"
                TextTrimming="CharacterEllipsis" />
              <Border
                Padding="6,1"
                HorizontalAlignment="Right"
                Background="{DynamicResource AccentFillColorDefaultBrush}"
                CornerRadius="4"
                Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}">
                <TextBlock
                  FontSize="11"
                  Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                  Text="{l:Tr Common_On}" />
              </Border>
              <ui:SymbolIcon
                HorizontalAlignment="Right"
                FontSize="16"
                Symbol="LockClosed24"
                ToolTip="{l:Tr Profiles_NeedsPro}"
                Visibility="{Binding IsLocked, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
            <TextBlock
              Margin="0,4,0,0"
              Style="{StaticResource Hint}"
              Text="{Binding Summary}"
              TextTrimming="CharacterEllipsis"
              TextWrapping="NoWrap" />
            <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
              <ui:SymbolIcon
                Margin="0,0,6,0"
                FontSize="13"
                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                Symbol="Keyboard24" />
              <TextBlock
                FontSize="12"
                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                Text="{Binding Hotkey, TargetNullValue={l:Tr Home_NoHotkey}}" />
              <ui:SymbolIcon
                Margin="6,0,0,0"
                FontSize="13"
                Foreground="{DynamicResource SystemFillColorCautionBrush}"
                Symbol="Warning24"
                ToolTip="{l:Tr Profiles_HotkeyInUse}"
                Visibility="{Binding HasHotkeyProblem, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
          </StackPanel>
        </DataTemplate>

        <!-- The last tile: a new profile, or more profiles with Pro once the free ones are used. -->
        <DataTemplate DataType="{x:Type vm:AddTileViewModel}">
          <Button
            AutomationProperties.Name="{Binding Title}"
            Click="OnAddTileClick"
            Style="{StaticResource AddTileButton}">
            <Button.ContextMenu>
              <ContextMenu>
                <MenuItem Command="{Binding DataContext.AddProfileCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Header="{l:Tr Profiles_Blank}" Icon="{ui:SymbolIcon Add24}" />
                <MenuItem Header="{l:Tr Profiles_FromTemplate}" Icon="{ui:SymbolIcon Sparkle24}" ItemsSource="{Binding DataContext.Templates, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                  <MenuItem.ItemContainerStyle>
                    <Style BasedOn="{StaticResource {x:Type MenuItem}}" TargetType="MenuItem">
                      <Setter Property="Header" Value="{Binding Name}" />
                      <Setter Property="ToolTip" Value="{Binding Description}" />
                      <Setter Property="Command" Value="{Binding DataContext.AddFromTemplateCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                      <Setter Property="CommandParameter" Value="{Binding Key}" />
                    </Style>
                  </MenuItem.ItemContainerStyle>
                </MenuItem>
                <MenuItem Command="{Binding DataContext.StartImportCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Header="{l:Tr Profiles_FromLink}" Icon="{ui:SymbolIcon Link24}" />
              </ContextMenu>
            </Button.ContextMenu>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
              <ui:SymbolIcon Margin="0,0,0,6" HorizontalAlignment="Center" FontSize="20">
                <ui:SymbolIcon.Style>
                  <Style TargetType="ui:SymbolIcon">
                    <Setter Property="Symbol" Value="Add24" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsLocked}" Value="True">
                        <Setter Property="Symbol" Value="LockClosed24" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </ui:SymbolIcon.Style>
              </ui:SymbolIcon>
              <TextBlock FontWeight="SemiBold" Text="{Binding Title}" TextAlignment="Center" TextWrapping="Wrap" />
              <TextBlock Style="{StaticResource Hint}" Text="{Binding Hint}" TextAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
          </Button>
        </DataTemplate>
      </ListBox.Resources>
    </ListBox>

    <!-- Add a profile someone shared -->
    <Border Style="{StaticResource SettingCard}" Visibility="{Binding IsImporting, Converter={StaticResource BoolToVisibility}}">
      <StackPanel>
        <TextBlock Text="{l:Tr Presets_ImportTitle}" />
        <TextBlock Style="{StaticResource Hint}" Text="{l:Tr Presets_ImportHint}" />
        <Grid Margin="0,10,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <ui:TextBox PlaceholderText="disphub://preset?name=…" Text="{Binding ImportText, UpdateSourceTrigger=PropertyChanged}">
            <ui:TextBox.InputBindings>
              <KeyBinding Key="Enter" Command="{Binding ImportCommand}" />
            </ui:TextBox.InputBindings>
          </ui:TextBox>
          <ui:Button
            Grid.Column="1"
            Margin="8,0,0,0"
            Appearance="Primary"
            Command="{Binding ImportCommand}"
            Content="{l:Tr Common_Add}" />
          <ui:Button
            Grid.Column="2"
            Margin="8,0,0,0"
            Command="{Binding CancelImportCommand}"
            Content="{l:Tr Common_Cancel}" />
        </Grid>
        <TextBlock
          Margin="0,6,0,0"
          Style="{StaticResource ErrorText}"
          Text="{Binding ImportError}"
          Visibility="{Binding ImportError, Converter={x:Static ctl:NullToCollapsedConverter.Instance}}" />
      </StackPanel>
    </Border>

    <!-- Editor -->
    <Border
      Margin="0,16,0,0"
      Padding="24,20"
      DataContext="{Binding Editor}"
      Style="{StaticResource SettingCard}"
      Visibility="{Binding HasProfile, Converter={StaticResource BoolToVisibility}}">
      <StackPanel>
        <Grid Margin="0,0,0,12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <ui:TextBox
            MaxWidth="360"
            HorizontalAlignment="Left"
            FontSize="18"
            FontWeight="SemiBold"
            MaxLength="40"
            PlaceholderText="{l:Tr Profiles_NamePlaceholder}"
            ctl:CommitOnEnter.IsEnabled="True"
            Text="{Binding Name, UpdateSourceTrigger=LostFocus}" />
          <StackPanel Grid.Column="1" Orientation="Horizontal">
            <ui:Button
              Margin="0,0,8,0"
              Command="{Binding ShareCommand}"
              Icon="{ui:SymbolIcon Share24}"
              ToolTip="{l:Tr Profiles_LinkCopied}">
              <ui:Button.Style>
                <Style BasedOn="{StaticResource {x:Type ui:Button}}" TargetType="ui:Button">
                  <Setter Property="Content" Value="{l:Tr Profiles_Share}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding LinkCopied}" Value="True">
                      <Setter Property="Content" Value="{l:Tr Common_LinkCopied}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </ui:Button.Style>
            </ui:Button>
            <ui:Button
              Margin="0,0,8,0"
              Command="{Binding ResetCommand}"
              Content="{l:Tr Profiles_Reset}"
              Icon="{ui:SymbolIcon ArrowReset24}" />
            <!-- What can be done with this profile, in one menu rather than a row of buttons. -->
            <ui:Button
              x:Name="MoreButton"
              AutomationProperties.Name="{l:Tr Profiles_More}"
              Click="OnMoreClick"
              Icon="{ui:SymbolIcon MoreHorizontal24}"
              ToolTip="{l:Tr Profiles_More}">
              <ui:Button.ContextMenu>
                <ContextMenu>
                  <MenuItem Command="{Binding DuplicateProfileCommand}" Header="{l:Tr Profiles_Duplicate}" Icon="{ui:SymbolIcon Copy24}" />
                  <MenuItem Command="{Binding MoveLeftCommand}" Header="{l:Tr Profiles_MoveLeft}" Icon="{ui:SymbolIcon ArrowLeft24}" />
                  <MenuItem Command="{Binding MoveRightCommand}" Header="{l:Tr Profiles_MoveRight}" Icon="{ui:SymbolIcon ArrowRight24}" />
                  <Separator />
                  <MenuItem Command="{Binding DeleteProfileCommand}" Header="{l:Tr Profiles_Delete}" Icon="{ui:SymbolIcon Delete24}" />
                </ContextMenu>
              </ui:Button.ContextMenu>
            </ui:Button>
          </StackPanel>
        </Grid>

        <Grid Margin="0,0,0,8" Visibility="{Binding ShowDisplayPicker, Converter={StaticResource BoolToVisibility}}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
            <ui:SymbolIcon
              Margin="0,0,10,0"
              FontSize="18"
              Symbol="Desktop24" />
            <TextBlock Text="{l:Tr Profiles_ApplyTo}" />
          </StackPanel>
          <ComboBox
            Grid.Column="1"
            MinWidth="220"
            ItemsSource="{Binding Displays}"
            SelectedItem="{Binding SelectedDisplay}" />
          <ui:HyperlinkButton
            Grid.Column="2"
            Margin="8,0,0,0"
            Command="{Binding ClearOverrideCommand}"
            Content="{l:Tr Profiles_UseMainSettings}"
            Visibility="{Binding HasOverride, Converter={StaticResource BoolToVisibility}}" />
        </Grid>

        <Grid Style="{StaticResource SliderRow}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="64" />
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <ui:SymbolIcon Margin="0,0,10,0" FontSize="18" Symbol="BrightnessHigh24" />
            <TextBlock Text="{l:Tr Profiles_Brightness}" />
          </StackPanel>
          <Slider
            Grid.Column="1"
            IsSnapToTickEnabled="True"
            Maximum="50"
            Minimum="-50"
            TickFrequency="1"
            Value="{Binding Brightness}" />
          <TextBlock
            Grid.Column="2"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Text="{Binding Brightness, StringFormat={}{0:+0;-0;0}}" />
        </Grid>

        <Grid Style="{StaticResource SliderRow}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="64" />
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <ui:SymbolIcon Margin="0,0,10,0" FontSize="18" Symbol="DarkTheme24" />
            <TextBlock Text="{l:Tr Profiles_Contrast}" />
          </StackPanel>
          <Slider
            Grid.Column="1"
            IsSnapToTickEnabled="True"
            Maximum="50"
            Minimum="-50"
            TickFrequency="1"
            Value="{Binding Contrast}" />
          <TextBlock
            Grid.Column="2"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Text="{Binding Contrast, StringFormat={}{0:+0;-0;0}}" />
        </Grid>

        <Grid Style="{StaticResource SliderRow}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="64" />
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <ui:SymbolIcon Margin="0,0,10,0" FontSize="18" Symbol="DataLine24" />
            <TextBlock Text="{l:Tr Profiles_Gamma}" />
          </StackPanel>
          <Slider
            Grid.Column="1"
            IsSnapToTickEnabled="True"
            Maximum="2.8"
            Minimum="0.3"
            TickFrequency="0.05"
            Value="{Binding Gamma}" />
          <TextBlock
            Grid.Column="2"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Text="{Binding Gamma, StringFormat={}{0:0.00}}" />
        </Grid>

        <!-- Lifts dark tones (Pro): what lets you see into dark corners of a game. -->
        <Grid Style="{StaticResource SliderRow}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="64" />
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <ui:SymbolIcon Margin="0,0,10,0" FontSize="18" Symbol="BrightnessLow24" />
            <TextBlock Text="{l:Tr Profiles_ShadowBoost}" />
          </StackPanel>
          <Slider
            Grid.Column="1"
            IsEnabled="{Binding CanUseShadowBoost}"
            IsSnapToTickEnabled="True"
            Maximum="100"
            Minimum="0"
            TickFrequency="1"
            Value="{Binding ShadowBoost}" />
          <TextBlock
            Grid.Column="2"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Text="{Binding ShadowBoost}"
            Visibility="{Binding CanUseShadowBoost, Converter={StaticResource BoolToVisibility}}" />
          <ui:Button
            Grid.Column="2"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Appearance="Transparent"
            AutomationProperties.Name="{l:Tr Profiles_ShadowBoostPro}"
            Command="{Binding UnlockShadowBoostCommand}"
            Icon="{ui:SymbolIcon LockClosed24}"
            ToolTip="{l:Tr Profiles_ShadowBoostPro}"
            Visibility="{Binding CanUseShadowBoost, Converter={x:Static ctl:InverseBoolToVisibilityConverter.Instance}}" />
        </Grid>
        <TextBlock
          Margin="180,0,64,8"
          Style="{StaticResource Hint}"
          Text="{l:Tr Profiles_ShadowBoostHint}" />

        <Grid Style="{StaticResource SliderRow}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="64" />
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <ui:SymbolIcon Margin="0,0,10,0" FontSize="18" Symbol="Temperature24" />
            <TextBlock Text="{l:Tr Profiles_Temperature}" />
          </StackPanel>
          <Slider
            Grid.Column="1"
            IsSnapToTickEnabled="True"
            Maximum="10000"
            Minimum="2000"
            TickFrequency="100"
            Value="{Binding Temperature}" />
          <TextBlock
            Grid.Column="2"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Text="{Binding Temperature, StringFormat={}{0} K}" />
        </Grid>

        <Grid Style="{StaticResource SliderRow}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="64" />
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <ui:SymbolIcon Margin="0,0,10,0" FontSize="18" Symbol="Color24" />
            <TextBlock Text="{l:Tr Profiles_Vibrance}" />
          </StackPanel>
          <Slider
            Grid.Column="1"
            IsEnabled="{Binding VibranceSupported}"
            IsSnapToTickEnabled="True"
            Maximum="100"
            Minimum="0"
            TickFrequency="1"
            Value="{Binding Vibrance}" />
          <TextBlock
            Grid.Column="2"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Text="{Binding Vibrance, StringFormat={}{0}%}" />
        </Grid>
        <TextBlock
          Margin="180,0,64,8"
          Style="{StaticResource Hint}"
          Text="{Binding VibranceHelp}" />

        <Separator Margin="0,12" />

        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <ui:SymbolIcon Margin="0,0,10,0" FontSize="18" Symbol="Keyboard24" />
            <TextBlock Text="{l:Tr Profiles_Hotkey}" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal">
            <ctl:HotkeyBox Gesture="{Binding Hotkey}" />
            <TextBlock
              Margin="12,0,0,0"
              VerticalAlignment="Center"
              Style="{StaticResource ErrorText}"
              Text="{Binding HotkeyError}" />
          </StackPanel>
        </Grid>
        <TextBlock
          Margin="180,6,0,0"
          Style="{StaticResource Hint}"
          Text="{l:Tr Profiles_HotkeyHint}" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
