<UserControl
  x:Class="DispHub.Views.ProfilesView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ctl="clr-namespace:DispHub.Controls"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:l="clr-namespace:DispHub.Localization"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:vm="clr-namespace:DispHub.ViewModels"
  d:DataContext="{d:DesignInstance Type=vm:ProfilesViewModel}"
  mc:Ignorable="d">
  <UserControl.Resources>
    <Style x:Key="SliderRow" TargetType="Grid">
      <Setter Property="Margin" Value="0,6" />
    </Style>
  </UserControl.Resources>

  <StackPanel>
    <Grid>
      <TextBlock Style="{StaticResource PageTitle}" Text="{l:Tr Profiles_Title}" />
      <ui:ToggleSwitch
        HorizontalAlignment="Right"
        VerticalAlignment="Center"
        Content="{Binding IsActive, Converter={x:Static ctl:ActiveTextConverter.Instance}}"
        IsChecked="{Binding IsActive}"
        ToolTip="{l:Tr Profiles_PauseTooltip}" />
    </Grid>
    <TextBlock Style="{StaticResource PageSubtitle}" Text="{Binding StatusText}" />

    <ItemsControl Margin="0,0,0,12" ItemsSource="{Binding Warnings}">
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="{x:Type vm:WarningViewModel}">
          <ui:InfoBar
            Title="{Binding Title}"
            Margin="0,0,0,6"
            IsClosable="False"
            IsOpen="True"
            Message="{Binding Message}"
            Severity="{Binding Severity}">
            <ui:Button
              Margin="0,0,0,4"
              Command="{Binding Action}"
              Content="{Binding ActionText}"
              Visibility="{Binding HasAction, Converter={StaticResource BoolToVisibility}}" />
          </ui:InfoBar>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <ListBox
      Margin="-2,0,0,0"
      Background="Transparent"
      BorderThickness="0"
      ItemContainerStyle="{StaticResource ProfileTile}"
      ItemsSource="{Binding Profiles}"
      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
      ScrollViewer.VerticalScrollBarVisibility="Disabled"
      SelectedItem="{Binding SelectedProfile}">
      <ListBox.Template>
        <ControlTemplate TargetType="ListBox">
          <ItemsPresenter />
        </ControlTemplate>
      </ListBox.Template>
      <ListBox.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel />
        </ItemsPanelTemplate>
      </ListBox.ItemsPanel>
      <ListBox.ItemTemplate>
        <DataTemplate DataType="{x:Type vm:ProfileItemViewModel}">
          <StackPanel>
            <Border Height="24" Margin="0,0,0,10" CornerRadius="4">
              <Border.Background>
                <ImageBrush ImageSource="{Binding Preview}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
              </Border.Background>
            </Border>
            <Grid>
              <TextBlock
                FontSize="14"
                FontWeight="SemiBold"
                Text="{Binding Name}"
                TextTrimming="CharacterEllipsis" />
              <Border
                Padding="6,1"
                HorizontalAlignment="Right"
                Background="{DynamicResource AccentFillColorDefaultBrush}"
                CornerRadius="4"
                Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}">
                <TextBlock
                  FontSize="11"
                  Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                  Text="{l:Tr Common_On}" />
              </Border>
            </Grid>
            <TextBlock
              Margin="0,4,0,0"
              Style="{StaticResource Hint}"
              Text="{Binding Summary}"
              TextTrimming="CharacterEllipsis"
              TextWrapping="NoWrap" />
            <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
              <ui:SymbolIcon
                Margin="0,0,6,0"
                FontSize="13"
                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                Symbol="Keyboard24" />
              <TextBlock
                FontSize="12"
                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                Text="{Binding Hotkey, TargetNullValue=No hotkey}" />
              <ui:SymbolIcon
                Margin="6,0,0,0"
                FontSize="13"
                Foreground="{DynamicResource SystemFillColorCautionBrush}"
                Symbol="Warning24"
                ToolTip="{l:Tr Profiles_HotkeyInUse}"
                Visibility="{Binding HasHotkeyProblem, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <WrapPanel Margin="0,4,0,0">
      <ui:Button
        Margin="0,0,8,8"
        Appearance="Primary"
        Command="{Binding AddProfileCommand}"
        Content="{l:Tr Profiles_New}"
        Icon="{ui:SymbolIcon Add24}" />
      <ui:Button
        x:Name="TemplatesButton"
        Margin="0,0,8,8"
        Click="OnTemplatesClick"
        Content="{l:Tr Profiles_FromTemplate}"
        Icon="{ui:SymbolIcon Sparkle24}">
        <ui:Button.ContextMenu>
          <ContextMenu ItemsSource="{Binding Templates}">
            <ContextMenu.ItemContainerStyle>
              <Style BasedOn="{StaticResource {x:Type MenuItem}}" TargetType="MenuItem">
                <Setter Property="Header" Value="{Binding Name}" />
                <Setter Property="ToolTip" Value="{Binding Description}" />
                <Setter Property="Command" Value="{Binding DataContext.AddFromTemplateCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                <Setter Property="CommandParameter" Value="{Binding Key}" />
              </Style>
            </ContextMenu.ItemContainerStyle>
          </ContextMenu>
        </ui:Button.ContextMenu>
      </ui:Button>
      <ui:Button
        Margin="0,0,8,8"
        Command="{Binding StartImportCommand}"
        Content="{l:Tr Profiles_FromLink}"
        Icon="{ui:SymbolIcon Link24}" />
      <ui:Button
        Margin="0,0,8,8"
        Command="{Binding DuplicateProfileCommand}"
        Content="{l:Tr Profiles_Duplicate}"
        Icon="{ui:SymbolIcon Copy24}" />
      <ui:Button
        Margin="0,0,8,8"
        Command="{Binding DeleteProfileCommand}"
        Content="{l:Tr Profiles_Delete}"
        Icon="{ui:SymbolIcon Delete24}" />
      <ui:Button
        Margin="0,0,4,8"
        Command="{Binding MoveLeftCommand}"
        Icon="{ui:SymbolIcon ArrowLeft24}"
        ToolTip="{l:Tr Profiles_MoveLeft}" />
      <ui:Button
        Margin="0,0,8,8"
        Command="{Binding MoveRightCommand}"
        Icon="{ui:SymbolIcon ArrowRight24}"
        ToolTip="{l:Tr Profiles_MoveRight}" />
    </WrapPanel>
    <TextBlock
      Margin="0,0,0,4"
      Style="{StaticResource Hint}"
      Text="{x:Static vm:ProfilesViewModel.ProfileLimitText}"
      Visibility="{Binding CanAddProfile, Converter={x:Static ctl:InverseBoolToVisibilityConverter.Instance}}" />

    <!-- Add a profile someone shared -->
    <Border Style="{StaticResource SettingCard}" Visibility="{Binding IsImporting, Converter={StaticResource BoolToVisibility}}">
      <StackPanel>
        <TextBlock Text="{l:Tr Presets_ImportTitle}" />
        <TextBlock Style="{StaticResource Hint}" Text="{l:Tr Presets_ImportHint}" />
        <Grid Margin="0,10,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <ui:TextBox PlaceholderText="disphub://preset?name=…" Text="{Binding ImportText, UpdateSourceTrigger=PropertyChanged}">
            <ui:TextBox.InputBindings>
              <KeyBinding Key="Enter" Command="{Binding ImportCommand}" />
            </ui:TextBox.InputBindings>
          </ui:TextBox>
          <ui:Button
            Grid.Column="1"
            Margin="8,0,0,0"
            Appearance="Primary"
            Command="{Binding ImportCommand}"
            Content="{l:Tr Common_Add}" />
          <ui:Button
            Grid.Column="2"
            Margin="8,0,0,0"
            Command="{Binding CancelImportCommand}"
            Content="{l:Tr Common_Cancel}" />
        </Grid>
        <TextBlock
          Margin="0,6,0,0"
          Style="{StaticResource ErrorText}"
          Text="{Binding ImportError}"
          Visibility="{Binding ImportError, Converter={x:Static ctl:NullToCollapsedConverter.Instance}}" />
      </StackPanel>
    </Border>

    <!-- Editor -->
    <Border
      Margin="0,16,0,0"
      Padding="24,20"
      DataContext="{Binding Editor}"
      Style="{StaticResource SettingCard}"
      Visibility="{Binding HasProfile, Converter={StaticResource BoolToVisibility}}">
      <StackPanel>
        <Grid Margin="0,0,0,12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <ui:TextBox
            MaxWidth="360"
            HorizontalAlignment="Left"
            FontSize="18"
            FontWeight="SemiBold"
            MaxLength="40"
            PlaceholderText="{l:Tr Profiles_NamePlaceholder}"
            ctl:CommitOnEnter.IsEnabled="True"
            Text="{Binding Name, UpdateSourceTrigger=LostFocus}" />
          <StackPanel Grid.Column="1" Orientation="Horizontal">
            <ui:Button
              Margin="0,0,8,0"
              Command="{Binding ShareCommand}"
              Content="{l:Tr Profiles_Share}"
              Icon="{ui:SymbolIcon Share24}" />
            <ui:Button
              Command="{Binding ResetCommand}"
              Content="{l:Tr Profiles_Reset}"
              Icon="{ui:SymbolIcon ArrowReset24}" />
          </StackPanel>
        </Grid>
        <TextBlock
          Margin="0,-4,0,8"
          Style="{StaticResource Hint}"
          Text="{Binding ShareMessage}"
          Visibility="{Binding ShareMessage, Converter={x:Static ctl:NullToCollapsedConverter.Instance}}" />

        <Grid Margin="0,0,0,8" Visibility="{Binding ShowDisplayPicker, Converter={StaticResource BoolToVisibility}}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
            <ui:SymbolIcon
              Margin="0,0,10,0"
              FontSize="18"
              Symbol="Desktop24" />
            <TextBlock Text="{l:Tr Profiles_ApplyTo}" />
          </StackPanel>
          <ComboBox
            Grid.Column="1"
            MinWidth="220"
            ItemsSource="{Binding Displays}"
            SelectedItem="{Binding SelectedDisplay}" />
          <ui:HyperlinkButton
            Grid.Column="2"
            Margin="8,0,0,0"
            Command="{Binding ClearOverrideCommand}"
            Content="{l:Tr Profiles_UseMainSettings}"
            Visibility="{Binding HasOverride, Converter={StaticResource BoolToVisibility}}" />
        </Grid>

        <Grid Style="{StaticResource SliderRow}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="64" />
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <ui:SymbolIcon Margin="0,0,10,0" FontSize="18" Symbol="BrightnessHigh24" />
            <TextBlock Text="{l:Tr Profiles_Brightness}" />
          </StackPanel>
          <Slider
            Grid.Column="1"
            IsSnapToTickEnabled="True"
            Maximum="50"
            Minimum="-50"
            TickFrequency="1"
            Value="{Binding Brightness}" />
          <TextBlock
            Grid.Column="2"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Text="{Binding Brightness, StringFormat={}{0:+0;-0;0}}" />
        </Grid>

        <Grid Style="{StaticResource SliderRow}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="64" />
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <ui:SymbolIcon Margin="0,0,10,0" FontSize="18" Symbol="DarkTheme24" />
            <TextBlock Text="{l:Tr Profiles_Contrast}" />
          </StackPanel>
          <Slider
            Grid.Column="1"
            IsSnapToTickEnabled="True"
            Maximum="50"
            Minimum="-50"
            TickFrequency="1"
            Value="{Binding Contrast}" />
          <TextBlock
            Grid.Column="2"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Text="{Binding Contrast, StringFormat={}{0:+0;-0;0}}" />
        </Grid>

        <Grid Style="{StaticResource SliderRow}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="64" />
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <ui:SymbolIcon Margin="0,0,10,0" FontSize="18" Symbol="DataLine24" />
            <TextBlock Text="{l:Tr Profiles_Gamma}" />
          </StackPanel>
          <Slider
            Grid.Column="1"
            IsSnapToTickEnabled="True"
            Maximum="2.8"
            Minimum="0.3"
            TickFrequency="0.05"
            Value="{Binding Gamma}" />
          <TextBlock
            Grid.Column="2"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Text="{Binding Gamma, StringFormat={}{0:0.00}}" />
        </Grid>

        <Grid Style="{StaticResource SliderRow}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="64" />
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <ui:SymbolIcon Margin="0,0,10,0" FontSize="18" Symbol="WeatherSunny24" />
            <TextBlock Text="{l:Tr Profiles_Temperature}" />
          </StackPanel>
          <Slider
            Grid.Column="1"
            IsSnapToTickEnabled="True"
            Maximum="10000"
            Minimum="2000"
            TickFrequency="100"
            Value="{Binding Temperature}" />
          <TextBlock
            Grid.Column="2"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Text="{Binding Temperature, StringFormat={}{0} K}" />
        </Grid>

        <Grid Style="{StaticResource SliderRow}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="64" />
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <ui:SymbolIcon Margin="0,0,10,0" FontSize="18" Symbol="Color24" />
            <TextBlock Text="{l:Tr Profiles_Vibrance}" />
          </StackPanel>
          <Slider
            Grid.Column="1"
            IsEnabled="{Binding VibranceSupported}"
            IsSnapToTickEnabled="True"
            Maximum="100"
            Minimum="0"
            TickFrequency="1"
            Value="{Binding Vibrance}" />
          <TextBlock
            Grid.Column="2"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Text="{Binding Vibrance, StringFormat={}{0}%}" />
        </Grid>
        <TextBlock
          Margin="180,0,64,8"
          Style="{StaticResource Hint}"
          Text="{Binding VibranceHelp}" />

        <Separator Margin="0,12" />

        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <ui:SymbolIcon Margin="0,0,10,0" FontSize="18" Symbol="Keyboard24" />
            <TextBlock Text="{l:Tr Profiles_Hotkey}" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal">
            <ctl:HotkeyBox Gesture="{Binding Hotkey}" />
            <TextBlock
              Margin="12,0,0,0"
              VerticalAlignment="Center"
              Style="{StaticResource ErrorText}"
              Text="{Binding HotkeyError}" />
          </StackPanel>
        </Grid>
        <TextBlock
          Margin="180,6,0,0"
          Style="{StaticResource Hint}"
          Text="{l:Tr Profiles_HotkeyHint}" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
