<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ctl="clr-namespace:DispHub.Controls"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

  <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

  <!-- Page title and section headings -->
  <Style x:Key="PageTitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="28" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="0,0,0,4" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
  </Style>
  <Style x:Key="PageSubtitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Margin" Value="0,0,0,20" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
  </Style>
  <Style x:Key="SectionHeader" TargetType="TextBlock">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="2,24,0,8" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
  </Style>
  <Style x:Key="Hint" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
  </Style>
  <Style x:Key="ErrorText" TargetType="TextBlock" BasedOn="{StaticResource Hint}">
    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
  </Style>

  <!-- A settings row: icon, title + description on the left, control on the right. -->
  <Style x:Key="SettingCard" TargetType="Border">
    <Setter Property="Padding" Value="16,12" />
    <Setter Property="Margin" Value="0,0,0,4" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
  </Style>

  <!-- A settings row (see SettingsCard): text on the left, the control on the right or, when narrow, below. -->
  <Style TargetType="ctl:SettingsCard">
    <Setter Property="Margin" Value="0,0,0,4" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ctl:SettingsCard">
          <Border
            Padding="16,12"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="6">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <ui:SymbolIcon
                x:Name="IconHost"
                Margin="0,0,14,0"
                VerticalAlignment="Center"
                FontSize="20"
                Symbol="{TemplateBinding Icon}" />
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{TemplateBinding Header}" TextWrapping="Wrap" />
                <TextBlock
                  x:Name="DescriptionText"
                  Style="{StaticResource Hint}"
                  Text="{TemplateBinding Description}" />
              </StackPanel>
              <ContentPresenter
                x:Name="Action"
                Grid.Column="2"
                Margin="16,0,0,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center" />
              <ContentPresenter
                x:Name="FooterHost"
                Grid.Row="2"
                Grid.ColumnSpan="3"
                Content="{TemplateBinding Footer}" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Icon" Value="Empty">
              <Setter TargetName="IconHost" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="Description" Value="{x:Null}">
              <Setter TargetName="DescriptionText" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="Footer" Value="{x:Null}">
              <Setter TargetName="FooterHost" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsWrapped" Value="True">
              <Setter TargetName="Action" Property="Grid.Row" Value="1" />
              <Setter TargetName="Action" Property="Grid.Column" Value="1" />
              <Setter TargetName="Action" Property="HorizontalAlignment" Value="Left" />
              <Setter TargetName="Action" Property="Margin" Value="0,10,0,0" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A section heading with actions on the right. -->
  <Style TargetType="ctl:SectionHeader">
    <Setter Property="Margin" Value="2,24,0,8" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ctl:SectionHeader">
          <Grid MinHeight="32">
            <TextBlock
              VerticalAlignment="Center"
              FontSize="14"
              FontWeight="SemiBold"
              Foreground="{DynamicResource TextFillColorPrimaryBrush}"
              Text="{TemplateBinding Text}" />
            <ContentPresenter HorizontalAlignment="Right" VerticalAlignment="Center" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Left navigation -->
  <Style x:Key="NavItem" TargetType="ListBoxItem">
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Grid>
            <Border
              x:Name="Back"
              Padding="12,9"
              Background="Transparent"
              CornerRadius="5">
              <ContentPresenter />
            </Border>
            <Rectangle
              x:Name="Pill"
              Width="3"
              Height="16"
              HorizontalAlignment="Left"
              Fill="{DynamicResource AccentFillColorDefaultBrush}"
              RadiusX="1.5"
              RadiusY="1.5"
              Visibility="Collapsed" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Back" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Back" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
              <Setter TargetName="Pill" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Profile tiles -->
  <Style x:Key="ProfileTile" TargetType="ListBoxItem">
    <Setter Property="Margin" Value="0,0,8,8" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border
            x:Name="Card"
            Width="196"
            Padding="14,12"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <ContentPresenter />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Card" Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
              <Setter TargetName="Card" Property="BorderThickness" Value="2" />
              <Setter TargetName="Card" Property="Padding" Value="13,11" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A choice chip in a horizontal list (e.g. the schedule's days). -->
  <Style x:Key="Chip" TargetType="ListBoxItem">
    <Setter Property="Margin" Value="0,0,6,0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border
            x:Name="Back"
            MinWidth="44"
            Padding="12,6"
            Background="{DynamicResource ControlFillColorDefaultBrush}"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="14">
            <ContentPresenter HorizontalAlignment="Center" TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Back" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Back" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
              <Setter TargetName="Back" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
              <Setter Property="TextElement.Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A card that can be selected, e.g. a schedule slot picked on the day view. -->
  <Style x:Key="SelectableCard" BasedOn="{StaticResource SettingCard}" TargetType="Border">
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsSelected}" Value="True">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- A round colour to pick (accent colour, tint colour): Name and Swatch come from the item. -->
  <Style x:Key="ColourSwatch" TargetType="ListBoxItem">
    <Setter Property="Margin" Value="0,0,4,4" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
    <Setter Property="ToolTip" Value="{Binding Name}" />
    <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Grid Width="32" Height="32" Background="Transparent">
            <Ellipse
              x:Name="Ring"
              Stroke="Transparent"
              StrokeThickness="2" />
            <Ellipse Margin="5" Fill="{Binding Swatch}" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource ControlStrokeColorSecondaryBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A row of round colours, wrapping when narrow. -->
  <Style x:Key="SwatchList" TargetType="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="ItemContainerStyle" Value="{StaticResource ColourSwatch}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBox">
          <ItemsPresenter />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="ItemsPanel">
      <Setter.Value>
        <ItemsPanelTemplate>
          <WrapPanel />
        </ItemsPanelTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
