<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <RootNamespace>DispHub</RootNamespace>
    <AssemblyName>DispHub</AssemblyName>
    <ApplicationIcon>Assets\DispHub.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- A tray app: no background GC thread, and hand memory back to Windows promptly. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <RetainVMGarbageCollection>false</RetainVMGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="unchihugo.WPF-UI" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\DispHub.Core\DispHub.Core.csproj" />
    <ProjectReference Include="..\DispHub.Platform\DispHub.Platform.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\..\presets\gallery.json" LogicalName="DispHub.gallery.json" Link="Assets\gallery.json" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\DispHub.ico" />
    <Resource Include="Assets\DispHub-paused.ico" />
    <Resource Include="Assets\DispHub.png" />
    <Resource Include="Assets\DispHub-64.png" />
    <Resource Include="Assets\wordmark.png" />
    <Resource Include="Assets\Previews\*.jpg" />
    <Resource Include="Assets\Onboarding\*.jpg" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="DispHub.Tests" />
  </ItemGroup>

  <!-- The languages DispHub offers are the translations present, so a new Strings.<culture>.resx (for example from
       Crowdin) shows up in Settings without code changes. Read at runtime by Loc.Languages. -->
  <Target Name="AddLanguageList" BeforeTargets="GetAssemblyAttributes">
    <ItemGroup>
      <_Translation Include="Localization\Strings.*.resx" />
    </ItemGroup>
    <PropertyGroup>
      <_Languages>@(_Translation->'%(Filename)'->Replace('Strings.', ''))</_Languages>
    </PropertyGroup>
    <ItemGroup>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>DispHub.Languages</_Parameter1>
        <_Parameter2>$(_Languages)</_Parameter2>
      </AssemblyAttribute>
    </ItemGroup>
  </Target>
</Project>
