<Project>
  <PropertyGroup>
    <Version>1.0.0</Version>
    <Authors>qlintenFX</Authors>
    <Product>DispHub</Product>
    <Copyright>Copyright © qlintenFX</Copyright>

    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>

    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Allow building with warnings locally while iterating: dotnet build -p:TreatWarningsAsErrors=false -->

    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Lets GitHub's Linux-based dependency graph restore these Windows projects. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
</Project>
